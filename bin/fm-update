#!/usr/bin/env bash
# fm-update - bring the local official FirstMate checkout (FIRSTMATE_ROOT) and
# this firstmate-config checkout to their remote tips, then reconcile this
# machine to firstmate-config via its own install.sh.
#
# Order:
#   1. Preconditions for BOTH repositories, before either is changed. Local
#      checks first; then origin's default branch is resolved and both remotes
#      are fetched (this only moves remote-tracking refs), and each checkout
#      must be a plain fast-forward of (or equal to) its upstream.
#   2. Fast-forward the official FirstMate checkout.
#   3. Fast-forward this firstmate-config checkout.
#   4. Run this checkout's own ./install.sh, then ./install.sh --verify.
# A refusal in step 1 changes neither working tree. A failure after step 2
# moved the official checkout is reported as a PARTIAL update, never as
# success; there is no multi-repository rollback.
#
# Every Git step is only ever a fast-forward. Nothing is forced, stashed,
# reset, merged, rebased, discarded, or pushed: a dirty or diverged checkout is
# reported and left exactly as it was, for a human to resolve. The official
# checkout is refused unless it is the root of a Git checkout with AGENTS.md,
# its origin's configured and effective (insteadOf-rewritten) URL is exactly
# firstmate_repo from firstmate/stack-manifest.tsv, it is on origin's default
# branch tracking origin/<default>, it has no unfinished merge/rebase/
# cherry-pick/revert/bisect, and it has no local commits missing from origin.
# Only that default branch is fetched there (never --prune). Secondmates and
# projects are never updated, and a running Captain is never restarted or
# notified: it keeps the instructions it loaded at startup until it is
# restarted through the official procedure (end the session, run `fm` again).
# fm-update never reimplements any of install.sh's reconciliation steps.
#
# Usage: fm update
set -u

ENV_FILE="${FM_CONFIG_ENV:-$HOME/.config/firstmate-config/env}"
# shellcheck source=/dev/null
[ ! -f "$ENV_FILE" ] || . "$ENV_FILE"

self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in /*) self=$target ;; *) self="$(cd "$(dirname "$self")" && pwd)/$target" ;; esac
done
CONFIG_ROOT="$(cd "$(dirname "$self")/.." && pwd)"
FIRSTMATE_ROOT="${FIRSTMATE_ROOT:-$HOME/Developer/tools/firstmate}"
export GIT_OPTIONAL_LOCKS=0

OFFICIAL_UPDATED= # "<old> -> <new>" once the official fast-forward has landed

restart_note() {
  printf 'A running Captain keeps the instructions it loaded at startup and was not restarted or notified.\n'
  printf 'To adopt the official update, restart it through the official procedure: end the Captain session, then run fm again.\n'
}
die() {
  printf 'fm-update: %s\n' "$1" >&2
  if [ -n "$OFFICIAL_UPDATED" ]; then
    printf 'fm-update: PARTIAL UPDATE: official FirstMate was fast-forwarded (%s), but the firstmate-config update did not complete; fix the error above and re-run fm update\n' "$OFFICIAL_UPDATED" >&2
    restart_note >&2
  fi
  exit 1
}
official_refuse() { die "official FirstMate checkout: $1; nothing was changed"; }
git_c() { git -C "$CONFIG_ROOT" "$@"; }
git_f() { git -C "$FIRSTMATE_ROOT" "$@"; }

case ${1:-} in
  --help|-h) printf 'Usage: fm update\n'; exit 0 ;;
  '') ;;
  *) die "unknown argument '$1'; see fm update --help" ;;
esac

command -v git >/dev/null 2>&1 || die 'git is not on PATH'

# --- 1a. local preconditions, no network -----------------------------------

# shellcheck source=firstmate/fm-stack-manifest.sh
. "$CONFIG_ROOT/firstmate/fm-stack-manifest.sh"
stack_manifest_load "$CONFIG_ROOT/firstmate/stack-manifest.tsv" || die "$SM_LOAD_ERROR; nothing was changed"
official=$SM_FIRSTMATE_REPO

[ -d "$FIRSTMATE_ROOT" ] || official_refuse "$FIRSTMATE_ROOT does not exist"
top=$(git_f rev-parse --show-toplevel 2>/dev/null) \
  || official_refuse "$FIRSTMATE_ROOT is not a Git checkout"
[ "$(cd "$top" && pwd -P)" = "$(cd "$FIRSTMATE_ROOT" && pwd -P)" ] \
  || official_refuse "$FIRSTMATE_ROOT is inside $top, not the root of a checkout"
[ -f "$FIRSTMATE_ROOT/AGENTS.md" ] \
  || official_refuse "$FIRSTMATE_ROOT has no AGENTS.md"
urls=$(git_f config --get-all remote.origin.url) \
  || official_refuse "$FIRSTMATE_ROOT has no 'origin' remote; expected $official"
[ "$urls" = "$official" ] \
  || official_refuse "origin is '$(printf '%s' "$urls" | tr '\n' ' ')', expected exactly $official"
effective=$(git_f remote get-url origin)
[ "$effective" = "$official" ] \
  || official_refuse "origin is rewritten to '$effective' by Git config; expected exactly $official"
f_branch=$(git_f symbolic-ref --quiet --short HEAD) \
  || official_refuse "$FIRSTMATE_ROOT is on a detached HEAD"
f_git_dir=$(git_f rev-parse --absolute-git-dir) \
  || official_refuse "cannot resolve the Git directory of $FIRSTMATE_ROOT"
for op in MERGE_HEAD rebase-merge rebase-apply CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
  [ ! -e "$f_git_dir/$op" ] || official_refuse "$FIRSTMATE_ROOT has an unfinished Git operation ($op)"
done
if [ -n "$(git_f status --porcelain)" ]; then
  printf 'fm-update: uncommitted local changes in %s\n' "$FIRSTMATE_ROOT" >&2
  git_f status --short >&2
  official_refuse 'commit or remove them yourself, then re-run'
fi

git_c rev-parse --is-inside-work-tree >/dev/null 2>&1 \
  || die "$CONFIG_ROOT is not a Git checkout"
branch=$(git_c symbolic-ref --quiet --short HEAD) \
  || die "$CONFIG_ROOT is on a detached HEAD; check out a branch first (nothing was changed)"
remote=$(git_c config --get "branch.$branch.remote") || remote=origin
old=$(git_c rev-parse --short HEAD)

# Refuse before touching the network: a dirty checkout can never be
# fast-forwarded safely, and this command will not decide what to do with it.
if [ -n "$(git_c status --porcelain)" ]; then
  printf 'fm-update: uncommitted local changes in %s\n' "$CONFIG_ROOT" >&2
  git_c status --short >&2
  die 'commit or stash them yourself, then re-run; nothing was changed'
fi

# --- 1b. remote preconditions; only remote-tracking refs move --------------

printf 'Checking default branch of official FirstMate (%s)...\n' "$official"
f_default=$(git_f ls-remote --symref origin HEAD 2>/dev/null \
  | sed -n 's|^ref: refs/heads/\([^[:space:]]*\)[[:space:]]*HEAD$|\1|p')
[ -n "$f_default" ] || official_refuse "cannot determine origin's default branch"
[ "$f_branch" = "$f_default" ] \
  || official_refuse "$FIRSTMATE_ROOT is on '$f_branch', expected origin's default branch '$f_default'"
if [ "$(git_f config --get "branch.$f_branch.remote")" != origin ] \
  || [ "$(git_f config --get "branch.$f_branch.merge")" != "refs/heads/$f_default" ]; then
  official_refuse "branch '$f_branch' does not track origin/$f_default; set it with 'git -C $FIRSTMATE_ROOT branch -u origin/$f_default'"
fi
printf 'Fetching official FirstMate origin...\n'
git_f fetch --quiet origin "refs/heads/$f_default:refs/remotes/origin/$f_default" \
  || official_refuse "cannot fast-forward-fetch '$f_default' from $official"
f_upstream="origin/$f_default"
f_old=$(git_f rev-parse --short HEAD)
f_new=$(git_f rev-parse --short "$f_upstream")
f_current=no
if [ "$(git_f rev-parse HEAD)" = "$(git_f rev-parse "$f_upstream")" ]; then
  f_current=yes
elif git_f merge-base --is-ancestor "$f_upstream" HEAD; then
  official_refuse "branch '$f_branch' has $(git_f rev-list --count "$f_upstream..HEAD") local commit(s) not on $f_upstream (unlanded work)"
elif ! git_f merge-base --is-ancestor HEAD "$f_upstream"; then
  official_refuse "branch '$f_branch' has diverged from $f_upstream ($f_old vs $f_new); resolve it manually"
fi

printf 'Fetching firstmate-config %s...\n' "$remote"
git_c fetch --quiet --prune "$remote" || die "cannot fetch from '$remote'; nothing was changed"
upstream=$(git_c rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) \
  || die "branch '$branch' has no upstream; set one with 'git branch -u $remote/$branch'; nothing was changed"
new=$(git_c rev-parse --short "$upstream")
current=no
if [ "$(git_c rev-parse HEAD)" = "$(git_c rev-parse "$upstream")" ]; then
  current=yes
elif ! git_c merge-base --is-ancestor HEAD "$upstream"; then
  die "branch '$branch' has diverged from '$upstream' ($old vs $new); resolve it manually; nothing was changed"
fi

# --- 2. official FirstMate --------------------------------------------------

if [ "$f_current" = yes ]; then
  printf 'Official FirstMate already up to date: %s at %s (%s)\n' "$f_branch" "$f_old" "$f_upstream"
else
  git_f merge --ff-only --quiet "$f_upstream" \
    || official_refuse "fast-forward to $f_upstream failed"
  OFFICIAL_UPDATED="$f_old -> $f_new"
  printf 'Updated official FirstMate %s: %s -> %s (%s commits from %s)\n' \
    "$f_branch" "$f_old" "$f_new" "$(git_f rev-list --count "$f_old..HEAD")" "$f_upstream"
  git_f --no-pager log --oneline "$f_old..HEAD"
fi
printf '\n'

# --- 3. firstmate-config ----------------------------------------------------

reconcile() { # <label> after the checkout is settled at its final commit
  printf '\nReconciling machine state (%s)...\n' "$1"
  install_out=$("$CONFIG_ROOT/install.sh"); install_status=$?
  printf '%s\n' "$install_out"
  [ "$install_status" -eq 0 ] \
    || die "install.sh failed after update; repository is at $(git_c rev-parse --short HEAD) but machine state was not reconciled"

  printf '\nVerifying reconciled state...\n'
  verify_out=$("$CONFIG_ROOT/install.sh" --verify); verify_status=$?
  printf '%s\n' "$verify_out"
  [ "$verify_status" -eq 0 ] \
    || die 'install.sh --verify failed after reconciling; investigate machine state'
  case $verify_out in
    *'verify: 0 drift item(s), 0 failure(s)'*) ;;
    *) die 'install.sh --verify reported drift after reconciling; investigate machine state' ;;
  esac
}

if [ "$current" = yes ]; then
  printf 'Already up to date: %s at %s (%s)\n' "$branch" "$old" "$upstream"
  reconcile 'already up to date'
else
  git_c merge --ff-only --quiet "$upstream" \
    || die "fast-forward to '$upstream' failed; firstmate-config was not changed"
  printf 'Updated %s: %s -> %s (%s commits from %s)\n' \
    "$branch" "$old" "$new" "$(git_c rev-list --count "$old..HEAD")" "$upstream"
  git_c --no-pager log --oneline "$old..HEAD"
  reconcile 'updated to '"$new"
fi

# --- 4. summary -------------------------------------------------------------

printf '\nfm update complete: official FirstMate %s; firstmate-config %s; machine reconciled and verified.\n' \
  "${OFFICIAL_UPDATED:-already up to date}" "$([ "$current" = yes ] && printf 'already up to date' || printf '%s -> %s' "$old" "$new")"
[ -z "$OFFICIAL_UPDATED" ] || restart_note
printf 'Secondmates and projects were not updated.\n'
