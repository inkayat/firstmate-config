#!/usr/bin/env python3
"""fm-bot - home-local bot specs and a dry, deterministic due evaluation.

A bot is a spec file plus the one watcher check that reads every spec; it is
never a process. Specs live at `$FM_HOME/data/bots/<name>.md` (machine-local,
never tracked). `due` evaluates them against Europe/Stockholm wall-clock time
and Firstmate's own backlog, and prints what is due; it never dispatches,
files, spawns, or calls a model. Firstmate acts on a `bot due:` line exactly
as it acts on any other custom-check wake.

Every spec carries the routine itself: role, project, route (an existing
`CATEGORY #N` dispatch rule), schedule, scope, access (`none` or a
`secret:<ref>` reference name, never a secret), notify, and limits (wall-clock
minutes, optional candidate/file/line caps, excluded paths). These fields are
stored and validated for the Captain and its workers to apply; fm-bot itself
enforces only the schedule and the level gate below.

A spec's `level` (local-proposal < local-commit < push) is an upper bound the
spec may claim, never an authorization. `local-proposal` (the default) needs
only an active, well-formed spec. The elevated levels each keep their gate:
captain authorization words with their own scope, an authorized-on date and
an unexpired `expires`, file and line limits, and a registered project whose
posture (the official `bin/fm-project-mode.sh`) allows the level - a
`local-only` project at most `local-commit`. `push` additionally needs
excluded paths, one remote, a branch prefix, at most one push per run, a
project without `+yolo`, and its authorization quoted verbatim in
`$FM_HOME/data/captain.md` (the home's standing-rules file) naming both the bot
and the project. `create` refuses any gate failure. `due` re-runs every check
on every evaluation, never trusting what `create` once accepted: a spec that
is not even a valid local-proposal reports `bot invalid:` and is never due,
and an elevated spec whose gate fails that day - expired, missing, or
insufficient authorization, a lost captain rule, an unresolvable or tightened
posture - is due at `local-proposal` with the reason. Nothing here can make a
commit or a push happen; those stay gated by Firstmate's own per-action
captain approval.

Schedule semantics: `--at`/`--until` are inclusive Europe/Stockholm wall-clock
minutes on the same local day, evaluated through zoneinfo (never host local
time). 02:xx is refused because that hour is ambiguous on the autumn DST day
and absent on the spring one. The dated task id is `<name>-<YYYYMMDD>` in
Stockholm local date; once the official `fm-tasks-axi.sh show <id> --full`
finds it the bot is silent for that day. A missed window is not backfilled.
`show --full` does not search the done archive, so each observed filing is
also kept in a durable per-bot marker (`data/bots/.filed/<name>`); a dated
task that is done and pruned to the archive later the same day stays filed.
The dispatch seam closes the remaining gap: `file <name>-<YYYYMMDD>` is how a
due bot's dated task is filed. It re-evaluates the bot at that instant,
refuses anything but today's due id (no backfill), adds the row through the
official `fm-tasks-axi.sh add`, writes the marker immediately after that add
succeeds - before anything is dispatched, so the task cannot have been done
and pruned yet - and prints the dispatch plan: kind, delivery, role file,
route, the routine fields, and the stop rule for the effective level. A bot
that is due but invalid is filed and held for the captain instead, with no
plan. `file` never spawns a worker. Filing a bot's dated id any other way
(a raw `fm-tasks-axi.sh add`) bypasses the filing-time marker and reopens
the poll-gap race.

`list` and `show` report each bot's last run: the newer of the newest
`<name>-<YYYYMMDD>` id the official `fm-tasks-axi.sh list` still shows and the
bot's filed marker, `none` when neither has one, `unknown` when the backlog
cannot answer.

Usage:
  fm-bot create NAME --role R --project P --route "CATEGORY #N"
                --at HH:MM --until HH:MM [--days daily|mon,tue,...]
                --scope TEXT --wall-clock-min N
                [--access none|secret:REF] [--notify report|needs-decision-on-high]
                [--max-candidates N] [--max-files N --max-lines N] [--exclude PATH ...]
                [--level local-proposal|local-commit|push]
                [--authorization "captain's exact words" --authorization-scope TEXT
                 --authorized-on YYYY-MM-DD --expires YYYY-MM-DD]
                [--push-remote R --push-branch-prefix PREFIX/ --push-max-per-run 1]
                [--now ISO]
  fm-bot list [--json] [--now ISO]
  fm-bot show NAME [--json] [--now ISO]
  fm-bot pause NAME | resume NAME | remove NAME
  fm-bot due [--check] [--json] [--now ISO]
  fm-bot file NAME-YYYYMMDD [--json] [--now ISO]
  fm-bot check-install

`due --check` is the watcher form: only actionable lines, always exit 0.
`check-install` writes `$FM_HOME/state/bots.check.sh` and binds it with the
official `bin/fm-check-register.sh bots`; its bytes pin this checkout, so run
it only from the checkout the home should use. Retire it with the official
`bin/fm-check-unregister.sh bots`.
"""
from __future__ import annotations

import argparse
import contextlib
import datetime
import fcntl
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time
import zoneinfo

SCHEMA = "fm-bot.v1"
TZ_NAME = "Europe/Stockholm"
LEVELS = ("local-proposal", "local-commit", "push")
STATES = ("active", "paused")
NOTIFY = ("report", "needs-decision-on-high")
WEEKDAYS = ("mon", "tue", "wed", "thu", "fri", "sat", "sun")
CHECK_ID = "bots"

# Registered delivery mode -> highest level a bot on that project may claim.
# local-only publishes nothing, so a push bot is impossible there.
POSTURE_CEILING = {
    "local-only": "local-commit",
    "direct-PR": "push",
    "no-mistakes": "push",
}

# \Z, not $: Python's $ also matches before a trailing newline, so a value
# such as "name\n" would pass here and read back as a different spec.
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,39}\Z")
ROLE_RE = re.compile(r"^[a-z0-9][a-z0-9-]*\Z")
PROJECT_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*\Z")
ROUTE_RE = re.compile(r"^([A-Z][A-Z/-]*) #([1-9][0-9]*)\Z")
HM_RE = re.compile(r"^([01][0-9]|2[0-3]):([0-5][0-9])\Z")
DATE_RE = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}\Z")
ACCESS_RE = re.compile(r"^(none|secret:[A-Za-z0-9][A-Za-z0-9._/-]{0,99})\Z")
REMOTE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*\Z")
BRANCH_PREFIX_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]*/\Z")
SPEC_LINE_RE = re.compile(r"^([a-z_]+): (.*)$")
LIST_ID_RE = re.compile(r"^\s+([A-Za-z0-9][A-Za-z0-9._-]*),")

TEXT_LIMITS = {"scope": 500, "authorization": 1000, "authorization_scope": 500, "exclude": 300}
# fm-watch.sh kills a check after 30 s: each backlog/posture call gets
# CALL_TIMEOUT, and a sweep stops evaluating once CHECK_BUDGET has passed.
CALL_TIMEOUT = 5
CHECK_BUDGET = 20

# Field order is the on-disk order. Required keys must be present in every
# spec; the rest appear only when set. `exclude` may repeat.
FIELDS = (
    "schema", "name", "state", "role", "project", "route", "days", "at", "until",
    "scope", "access", "notify", "wall_clock_min", "max_candidates", "max_files",
    "max_lines", "exclude", "level", "authorization", "authorization_scope",
    "authorized_on", "expires", "push_remote", "push_branch_prefix",
    "push_max_per_run", "created_at", "updated_at",
)
REQUIRED_KEYS = (
    "schema", "name", "state", "role", "project", "route", "days", "at", "until",
    "scope", "access", "notify", "wall_clock_min", "level", "created_at", "updated_at",
)
REPEATED_KEYS = ("exclude",)
AUTH_KEYS = ("authorization", "authorization_scope", "authorized_on", "expires")
PUSH_KEYS = ("push_remote", "push_branch_prefix", "push_max_per_run")


class SpecError(Exception):
    """One refusal: a fixed machine code plus a human message. Only the code
    ever reaches a watcher line, so spec text never lands in a wake."""

    def __init__(self, code: str, message: str):
        super().__init__(message)
        self.code = code
        self.message = message


def die(msg: str) -> "None":
    print(f"fm-bot: {msg}", file=sys.stderr)
    sys.exit(1)


def now_iso() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def code_of(key: str) -> str:
    return key.replace("_", "-")


# --- paths -------------------------------------------------------------------

def fm_home() -> str:
    return os.environ.get("FM_HOME") or os.path.expanduser("~/.firstmate")


def firstmate_root() -> str:
    return os.environ.get("FIRSTMATE_ROOT") or os.path.expanduser("~/Developer/tools/firstmate")


def config_root() -> str:
    return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def bots_dir() -> str:
    return os.path.join(fm_home(), "data", "bots")


def spec_path(name: str) -> str:
    return os.path.join(bots_dir(), f"{name}.md")


def spec_rel(name: str) -> str:
    return f"data/bots/{name}.md"


def captain_rules_path() -> str:
    return os.path.join(fm_home(), "data", "captain.md")


def check_path() -> str:
    return os.path.join(fm_home(), "state", f"{CHECK_ID}.check.sh")


# --- time ----------------------------------------------------------------------

def stockholm() -> datetime.tzinfo:
    return zoneinfo.ZoneInfo(TZ_NAME)


def parse_now(value: str | None) -> datetime.datetime:
    """The evaluation instant, always timezone-aware. `--now` exists so a
    fixture can pin the clock; a naive value is refused because it would
    silently mean host local time."""
    if value is None:
        return datetime.datetime.now(datetime.timezone.utc)
    try:
        moment = datetime.datetime.fromisoformat(value[:-1] + "+00:00" if value.endswith("Z") else value)
    except ValueError:
        die(f"--now must be an ISO 8601 instant with an offset, e.g. 2026-10-25T02:00Z (got '{value}')")
    if moment.tzinfo is None:
        die(f"--now must carry an offset or Z (got '{value}')")
    return moment


def local_now(moment: datetime.datetime) -> datetime.datetime:
    return moment.astimezone(stockholm())


def hm_minutes(value: str) -> int:
    h, m = value.split(":")
    return int(h) * 60 + int(m)


def parse_days(value: str) -> tuple[str, ...]:
    if value == "daily":
        return WEEKDAYS
    parts = value.split(",")
    if not parts or any(p not in WEEKDAYS for p in parts) or len(set(parts)) != len(parts):
        raise SpecError("bad-days", f"days must be 'daily' or a comma list of {','.join(WEEKDAYS)} (got '{value}')")
    return tuple(d for d in WEEKDAYS if d in parts)


def normalize_days(value: str) -> str:
    days = parse_days(value)
    return "daily" if days == WEEKDAYS else ",".join(days)


def in_window(spec: dict, local: datetime.datetime) -> bool:
    if WEEKDAYS[local.weekday()] not in parse_days(spec["days"]):
        return False
    minute = local.hour * 60 + local.minute
    return hm_minutes(spec["at"]) <= minute <= hm_minutes(spec["until"])


def next_window_start(spec: dict, local: datetime.datetime) -> datetime.datetime:
    """The next local window start strictly after `local`. 02:xx is refused
    for `at`, so the wall time exists exactly once on every date."""
    days = parse_days(spec["days"])
    h, m = (int(x) for x in spec["at"].split(":"))
    for offset in range(0, 8):
        day = local.date() + datetime.timedelta(days=offset)
        if WEEKDAYS[day.weekday()] not in days:
            continue
        start = datetime.datetime(day.year, day.month, day.day, h, m, tzinfo=stockholm())
        if start > local:
            return start
    raise AssertionError("a non-empty weekly schedule always has a next start")


def dated_id(name: str, local: datetime.datetime) -> str:
    return f"{name}-{local.strftime('%Y%m%d')}"


# --- spec file I/O --------------------------------------------------------------

def _refuse_symlink(path: str, what: str) -> None:
    if os.path.islink(path):
        die(f"{what} is a symlink, refusing to follow it: {path}")


@contextlib.contextmanager
def _lock(lock_name: str = ".lock"):
    _refuse_symlink(os.path.join(fm_home(), "data"), "data directory")
    _refuse_symlink(bots_dir(), "bots directory")
    os.makedirs(bots_dir(), mode=0o700, exist_ok=True)
    lock_fd = os.open(os.path.join(bots_dir(), lock_name), os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)
        os.close(lock_fd)


def _atomic_write(path: str, content: str, mode: int) -> None:
    _refuse_symlink(path, "target")
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.remove(tmp)
        raise


def parse_spec_text(text: str) -> dict:
    spec: dict = {"exclude": []}
    # Only "\n" ends a spec line: splitlines() would also split at U+2028,
    # NEL and similar, which can hide one field inside another's value.
    for raw in text.split("\n"):
        if not raw.strip() or raw.startswith("#"):
            continue
        m = SPEC_LINE_RE.match(raw)
        if not m:
            raise SpecError("unreadable", f"unparseable spec line: {raw[:60]!r}")
        key, value = m.group(1), m.group(2)
        if key in REPEATED_KEYS:
            spec[key].append(value)
        elif key in FIELDS:
            if key in spec:
                raise SpecError("unreadable", f"duplicate spec key '{key}'")
            spec[key] = value
        else:
            raise SpecError("unreadable", f"unknown spec key '{key}'")
    missing = [k for k in REQUIRED_KEYS if k not in spec]
    if missing:
        raise SpecError("unreadable", f"spec is missing: {', '.join(missing)}")
    return spec


def render_spec(spec: dict) -> str:
    lines = [f"# Bot spec ({SCHEMA}). Written by fm-bot; every field is re-validated on each evaluation."]
    for key in FIELDS:
        if key in REPEATED_KEYS:
            lines.extend(f"{key}: {v}" for v in spec.get(key, []))
        elif spec.get(key) not in (None, ""):
            lines.append(f"{key}: {spec[key]}")
    return "\n".join(lines) + "\n"


def read_spec(name: str) -> dict:
    with open(spec_path(name), "r", encoding="utf-8") as f:
        return parse_spec_text(f.read())


def load_spec(name: str) -> dict:
    path = spec_path(name)
    _refuse_symlink(path, "bot spec")
    if not os.path.isfile(path):
        die(f"no such bot '{name}'")
    try:
        return read_spec(name)
    except SpecError as exc:
        die(f"bot '{name}' spec is invalid: {exc.message}")
    except ValueError as exc:
        die(f"bot '{name}' spec is invalid: not UTF-8 text ({exc})")


def spec_names() -> list[str]:
    if not os.path.isdir(bots_dir()):
        return []
    return sorted(e[:-3] for e in os.listdir(bots_dir())
                  if e.endswith(".md") and NAME_RE.match(e[:-3]))


def require_name(name: str) -> str:
    if not NAME_RE.match(name or ""):
        die(f"invalid bot name '{name}' (lowercase letters, digits, hyphens; at most 40; must start with a letter or digit)")
    return name


# --- validation -------------------------------------------------------------------

def _text(spec: dict, key: str) -> None:
    values = spec[key] if isinstance(spec.get(key), list) else [spec.get(key)]
    for value in values:
        if value is None or not value.strip():
            raise SpecError(f"missing-{code_of(key)}", f"{key} is required")
        if not all(c.isprintable() for c in value):
            raise SpecError(f"bad-{code_of(key)}", f"{key} must be one line of printable text")
        if len(value) > TEXT_LIMITS.get(key, 200):
            raise SpecError(f"bad-{code_of(key)}", f"{key} is longer than {TEXT_LIMITS.get(key, 200)} characters")


def _date(spec: dict, key: str) -> datetime.date:
    value = spec.get(key)
    if value is None:
        raise SpecError(f"missing-{code_of(key)}", f"{key} is required for level {spec.get('level')}")
    if not DATE_RE.match(value):
        raise SpecError(f"bad-{code_of(key)}", f"{key} must be YYYY-MM-DD (got '{value}')")
    try:
        return datetime.date.fromisoformat(value)
    except ValueError:
        raise SpecError(f"bad-{code_of(key)}", f"{key} is not a calendar date (got '{value}')") from None


def _positive_int(spec: dict, key: str) -> None:
    value = spec.get(key)
    if value is None:
        raise SpecError(f"missing-{code_of(key)}", f"{key} is required for level {spec.get('level')}")
    if not re.fullmatch(r"[0-9]+", value) or int(value) < 1:
        raise SpecError(f"bad-{code_of(key)}", f"{key} must be a positive integer (got '{value}')")


def _route_valid(route: str) -> bool:
    m = ROUTE_RE.match(route)
    if not m:
        return False
    with open(os.path.join(config_root(), "firstmate", "crew-dispatch.json"), "r", encoding="utf-8") as f:
        rules = json.load(f).get("rules", [])
    return int(m.group(2)) <= sum(1 for r in rules if r.get("category") == m.group(1))


def normalize_words(text: str) -> str:
    return " ".join(text.split())


def names_word(text: str, word: str) -> bool:
    """`word` appears in `text` as a whole token, not inside a longer name."""
    return re.search(rf"(?<![\w-]){re.escape(word)}(?![\w-])", text) is not None


def check_base(spec: dict, name: str) -> None:
    """Everything a valid local-proposal spec needs, independent of the
    clock, the registry, and the captain's rules. Optional fields are checked
    for shape whenever present, at every level. Raises the first SpecError."""
    if spec.get("schema") != SCHEMA:
        raise SpecError("bad-schema", f"schema must be {SCHEMA}")
    if spec.get("name") != name or not NAME_RE.match(name):
        raise SpecError("bad-name", "spec name must match its file name")
    if spec.get("state") not in STATES:
        raise SpecError("bad-state", f"state must be one of {', '.join(STATES)}")
    role = spec.get("role") or ""
    if not ROLE_RE.match(role) or not os.path.isfile(os.path.join(config_root(), "roles", role, "ROLE.md")):
        raise SpecError("unknown-role", f"role '{role}' has no roles/{role}/ROLE.md in {config_root()}")
    if not PROJECT_RE.match(spec.get("project") or ""):
        raise SpecError("bad-project", f"project '{spec.get('project')}' is not a valid project name")
    if not _route_valid(spec.get("route") or ""):
        raise SpecError("unknown-route", f"route '{spec.get('route')}' is not an existing 'CATEGORY #N' rule in firstmate/crew-dispatch.json")
    parse_days(spec.get("days") or "")
    for key in ("at", "until"):
        value = spec.get(key) or ""
        if not HM_RE.match(value):
            raise SpecError(f"bad-{key}", f"{key} must be HH:MM (got '{value}')")
        if value.startswith("02:"):
            raise SpecError("dst-hour", f"{key} {value} is in 02:xx, which is ambiguous or absent on {TZ_NAME} DST days")
    if hm_minutes(spec["until"]) < hm_minutes(spec["at"]):
        raise SpecError("bad-window", "until must not be earlier than at (windows never cross midnight)")
    _text(spec, "scope")
    if not ACCESS_RE.match(spec.get("access") or ""):
        raise SpecError("bad-access", "access must be 'none' or 'secret:<reference-name>' (a reference, never the secret)")
    if spec.get("notify") not in NOTIFY:
        raise SpecError("bad-notify", f"notify must be one of {', '.join(NOTIFY)}")
    _positive_int(spec, "wall_clock_min")
    for key in ("max_candidates", "max_files", "max_lines"):
        if spec.get(key) is not None:
            _positive_int(spec, key)
    if spec.get("exclude"):
        _text(spec, "exclude")
    if spec.get("level") not in LEVELS:
        raise SpecError("bad-level", f"level must be one of {', '.join(LEVELS)}")
    for key in ("authorization", "authorization_scope"):
        if spec.get(key) is not None:
            _text(spec, key)
    for key in ("authorized_on", "expires"):
        if spec.get(key) is not None:
            _date(spec, key)
    if spec.get("level") != "push":
        for key in PUSH_KEYS:
            if spec.get(key) is not None:
                raise SpecError("unexpected-push-field", f"{key} applies only to level push")


def project_posture(project: str) -> tuple[str, str]:
    """(mode, yolo) from the official registered-posture lookup. Its fallback
    for an unknown project is a warning plus a default posture, so that
    warning is read as 'unregistered' instead of trusting the default."""
    script = os.path.join(firstmate_root(), "bin", "fm-project-mode.sh")
    if not os.path.isfile(script):
        raise SpecError("posture-unavailable", f"cannot read project posture: {script} is missing")
    try:
        out = subprocess.run([script, project], capture_output=True, text=True, timeout=CALL_TIMEOUT,
                             env={**os.environ, "FM_HOME": fm_home()})
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise SpecError("posture-unavailable", f"cannot read project posture: {exc}") from None
    if out.returncode != 0:
        raise SpecError("posture-refused", f"fm-project-mode.sh refused '{project}': {out.stderr.strip()}")
    if "not in registry" in out.stderr or "no registry at" in out.stderr or "unknown mode" in out.stderr:
        raise SpecError("project-unregistered", f"project '{project}' has no registered posture in data/projects.md")
    parts = out.stdout.split()
    if len(parts) != 2 or parts[0] not in POSTURE_CEILING or parts[1] not in ("on", "off"):
        raise SpecError("posture-unavailable", f"unexpected posture output: {out.stdout.strip()!r}")
    return parts[0], parts[1]


def check_elevated(spec: dict, name: str, today: datetime.date) -> None:
    """The gate for local-commit and push, re-evaluated every time: the
    authorization, the limits, the push scope, the registered posture, and
    the captain's standing rule. A local-proposal spec never reaches it.
    Raises the first SpecError."""
    level = spec["level"]
    for key in ("authorization", "authorization_scope"):
        if spec.get(key) is None:
            raise SpecError(f"missing-{code_of(key)}", f"{key} is required for level {level}")
    authorized_on, expires = _date(spec, "authorized_on"), _date(spec, "expires")
    if authorized_on > expires:
        raise SpecError("bad-expires", "expires must not be earlier than authorized_on")
    _positive_int(spec, "max_files")
    _positive_int(spec, "max_lines")
    if level == "push":
        if not spec.get("exclude"):
            raise SpecError("missing-exclude", "push needs at least one --exclude path")
        if not REMOTE_RE.match(spec.get("push_remote") or ""):
            raise SpecError("missing-push-remote", "push needs --push-remote naming one git remote")
        prefix = spec.get("push_branch_prefix") or ""
        if not BRANCH_PREFIX_RE.match(prefix) or ".." in prefix or "//" in prefix:
            raise SpecError("missing-push-branch-prefix", "push needs --push-branch-prefix ending in '/', e.g. bot/<name>/")
        if spec.get("push_max_per_run") != "1":
            raise SpecError("bad-push-max-per-run", "push allows at most one push/PR per run (--push-max-per-run 1)")
        words = normalize_words(spec["authorization"])
        if not names_word(words, name) or not names_word(words, spec["project"]):
            raise SpecError("authorization-unscoped", "a push authorization must name both the bot and the project")
    mode, yolo = project_posture(spec["project"])
    if LEVELS.index(level) > LEVELS.index(POSTURE_CEILING[mode]):
        raise SpecError("level-above-posture", f"{spec['project']} is registered {mode}; its bots may claim at most {POSTURE_CEILING[mode]}")
    if level == "push" and yolo == "on":
        raise SpecError("push-with-yolo", f"{spec['project']} is registered +yolo; a push bot needs a project where firstmate never merges on its own")
    if authorized_on > today:
        raise SpecError("authorization-future", "authorized_on is after today")
    if expires < today:
        raise SpecError("authorization-expired", f"authorization expired {spec['expires']}")
    if level == "push":
        rules = ""
        with contextlib.suppress(OSError), open(captain_rules_path(), "r", encoding="utf-8") as f:
            rules = f.read()
        if normalize_words(spec["authorization"]) not in normalize_words(rules):
            raise SpecError("captain-rule-missing", "a push authorization must appear verbatim in data/captain.md")


# --- backlog --------------------------------------------------------------------

def _tasks_axi(*args: str) -> subprocess.CompletedProcess | None:
    script = os.path.join(firstmate_root(), "bin", "fm-tasks-axi.sh")
    if not os.path.isfile(script):
        return None
    try:
        return subprocess.run([script, *args], capture_output=True, text=True, timeout=CALL_TIMEOUT,
                              env={**os.environ, "FM_HOME": fm_home()})
    except (OSError, subprocess.TimeoutExpired):
        return None


def backlog_has(task_id: str) -> bool | None:
    """True/False from the official fm-tasks-axi.sh, None when the backlog
    cannot answer (so the caller reports an error instead of guessing)."""
    out = _tasks_axi("show", task_id, "--full")
    if out is None:
        return None
    if out.returncode == 0:
        return True
    if out.returncode == 1 and "NOT_FOUND" in out.stdout + out.stderr:
        return False
    return None


# The backlog's retention prunes done rows into an archive that
# `fm-tasks-axi.sh show --full` does not search, so a dated id that was filed,
# finished, and pruned inside its own window would look unfiled again. Each
# bot therefore keeps one durable marker, `data/bots/.filed/<name>`, holding
# the newest dated id the backlog has ever shown for it. Only an observed
# backlog hit writes it - never a due line - so an unanswered wake keeps
# waking until firstmate files the id, exactly as before. `remove` leaves it,
# so a bot recreated under the same name cannot re-fire a day it already ran.

def filed_marker_path(name: str) -> str:
    return os.path.join(bots_dir(), ".filed", name)


def read_filed_marker(name: str) -> str | None:
    path = filed_marker_path(name)
    if os.path.islink(path) or not os.path.isfile(path):
        return None
    try:
        with open(path, "r", encoding="utf-8") as f:
            value = f.read().strip()
    except OSError:
        return None
    return value if re.fullmatch(rf"{re.escape(name)}-[0-9]{{8}}", value) else None


def record_filed(name: str, task_id: str) -> None:
    """Advance the marker to `task_id` (ids of one bot sort by date)."""
    if (read_filed_marker(name) or "") >= task_id:
        return
    with _lock():
        directory = os.path.dirname(filed_marker_path(name))
        _refuse_symlink(directory, "filed-marker directory")
        os.makedirs(directory, mode=0o700, exist_ok=True)
        if (read_filed_marker(name) or "") < task_id:
            _atomic_write(filed_marker_path(name), task_id + "\n", 0o600)


def last_runs(names: list[str]) -> dict | None:
    """{name: newest dated id} from one official `fm-tasks-axi.sh list` plus
    each bot's filed marker (which outlives backlog pruning), or None when the
    backlog cannot answer. Only an exact `<name>-<YYYYMMDD>` id counts, so a
    bot named `a` never claims `a-b-20261001`."""
    if not names:
        return {}
    out = _tasks_axi("list", "--limit", "100000")
    if out is None or out.returncode != 0:
        return None
    patterns = {n: re.compile(rf"^{re.escape(n)}-([0-9]{{8}})$") for n in names}
    newest: dict = {n: read_filed_marker(n) or "" for n in names}
    for line in out.stdout.splitlines():
        m = LIST_ID_RE.match(line)
        if not m:
            continue
        for name, pattern in patterns.items():
            if pattern.match(m.group(1)) and m.group(1) > newest[name]:
                newest[name] = m.group(1)
    return {n: v for n, v in newest.items() if v}


def last_run_label(name: str, runs: dict | None) -> str:
    if runs is None:
        return "unknown"
    return runs.get(name) or "none"


# --- evaluation -------------------------------------------------------------------

def evaluate(name: str, moment: datetime.datetime) -> dict:
    """One bot's verdict at `moment`. Order matters: a paused or out-of-window
    bot is silent without touching the backlog, so a sweep costs nothing
    outside windows; validity is judged only when the bot would fire, so a
    broken spec surfaces once per window and is silenced by filing its id.
    An unreadable spec cannot prove it is paused or outside its window, so it
    surfaces every day until that day's id is filed or the spec is fixed."""
    local = local_now(moment)
    result = {"name": name, "id": dated_id(name, local), "spec": spec_rel(name),
              "local": local.strftime("%Y-%m-%d %H:%M %Z")}
    spec, unreadable = None, None
    try:
        if os.path.islink(spec_path(name)):
            # file/show/pause refuse a symlinked spec, so report it here too
            # rather than raise a due line that can never be filed.
            raise SpecError("symlink", "the spec is a symlink")
        spec = read_spec(name)
    except SpecError as exc:
        unreadable = {"reason": exc.code, "detail": exc.message}
    except (OSError, ValueError) as exc:  # ValueError: not UTF-8
        unreadable = {"reason": "unreadable", "detail": str(exc)}
    if spec is not None and spec.get("state") == "paused":
        return {**result, "verdict": "paused"}
    try:
        window = spec is None or in_window(spec, local)
    except (SpecError, ValueError, KeyError):
        window = True  # a malformed schedule cannot prove the bot is quiet
    if not window:
        return {**result, "verdict": "outside-window"}
    if read_filed_marker(name) == result["id"]:
        return {**result, "verdict": "filed"}
    filed = backlog_has(result["id"])
    if filed is None:
        return {**result, "verdict": "error", "reason": "backlog-unavailable",
                "detail": "fm-tasks-axi.sh could not answer"}
    if filed:
        # A marker that cannot be written must not change today's verdict:
        # the backlog still answers until the row is pruned, and the next
        # sweep retries. die() raises SystemExit, hence its suppression here.
        with contextlib.suppress(OSError, SystemExit):
            record_filed(name, result["id"])
        return {**result, "verdict": "filed"}
    if unreadable is not None:
        return {**result, "verdict": "invalid", **unreadable}
    try:
        check_base(spec, name)
    except SpecError as exc:
        return {**result, "verdict": "invalid", "reason": exc.code, "detail": exc.message}
    result.update(verdict="due", requested=spec["level"], level=spec["level"])
    if spec["level"] != "local-proposal":
        try:
            check_elevated(spec, name, local.date())
        except SpecError as exc:
            result.update(level="local-proposal", reason=exc.code, detail=exc.message)
    return result


def watcher_line(r: dict) -> str | None:
    if r["verdict"] == "due":
        line = f"bot due: {r['id']} spec={r['spec']} level={r['level']}"
        if r.get("reason"):
            line += f" requested={r['requested']} reason={r['reason']}"
        return line
    if r["verdict"] == "invalid":
        return f"bot invalid: {r['id']} spec={r['spec']} reason={r['reason']}"
    if r["verdict"] == "error":
        return f"bot error: {r['id']} reason={r['reason']}"
    return None


# --- commands ---------------------------------------------------------------------

def cmd_create(args: argparse.Namespace) -> None:
    name = require_name(args.name)
    moment = parse_now(args.now)
    ts = now_iso()
    spec = {
        "schema": SCHEMA, "name": name, "state": "active", "role": args.role,
        "project": args.project, "route": args.route, "days": args.days,
        "at": args.at, "until": args.until, "scope": args.scope,
        "access": args.access, "notify": args.notify,
        "wall_clock_min": args.wall_clock_min, "max_candidates": args.max_candidates,
        "max_files": args.max_files, "max_lines": args.max_lines,
        "exclude": args.exclude or [], "level": args.level,
        "authorization": normalize_words(args.authorization) if args.authorization is not None else None,
        "authorization_scope": args.authorization_scope,
        "authorized_on": args.authorized_on, "expires": args.expires,
        "push_remote": args.push_remote, "push_branch_prefix": args.push_branch_prefix,
        "push_max_per_run": args.push_max_per_run,
        "created_at": ts, "updated_at": ts,
    }
    try:
        spec["days"] = normalize_days(args.days)
        check_base(spec, name)
        if spec["level"] != "local-proposal":
            check_elevated(spec, name, local_now(moment).date())
    except SpecError as exc:
        die(f"refused ({exc.code}): {exc.message}")
    with _lock():
        if os.path.lexists(spec_path(name)):
            die(f"bot '{name}' already exists (remove it first, or pause/resume it)")
        _atomic_write(spec_path(name), render_spec(spec), 0o600)
    print(f"created: {name} ({spec_rel(name)})")


def _set_state(name: str, state: str) -> None:
    require_name(name)
    with _lock():
        spec = load_spec(name)
        if spec["state"] == state:
            print(f"unchanged: {name} already {state}")
            return
        spec["state"] = state
        spec["updated_at"] = now_iso()
        _atomic_write(spec_path(name), render_spec(spec), 0o600)
    print(f"{'paused' if state == 'paused' else 'resumed'}: {name}")


def cmd_pause(args: argparse.Namespace) -> None:
    _set_state(args.name, "paused")


def cmd_resume(args: argparse.Namespace) -> None:
    _set_state(args.name, "active")


def cmd_remove(args: argparse.Namespace) -> None:
    name = require_name(args.name)
    with _lock():
        path = spec_path(name)
        _refuse_symlink(path, "bot spec")
        if not os.path.isfile(path):
            die(f"no such bot '{name}'")
        os.remove(path)
    print(f"removed: {name}")


SUMMARY_FIELDS = ("state", "level", "role", "project", "route", "days", "at", "until",
                  "access", "notify", "wall_clock_min", "expires")


def _summary(name: str, moment: datetime.datetime, runs: dict | None) -> dict:
    local = local_now(moment)
    row = {"name": name, "spec": spec_rel(name), "last_run": last_run_label(name, runs)}
    try:
        spec = read_spec(name)
        row.update({k: spec.get(k) for k in SUMMARY_FIELDS})
        row["schedule"] = f"{spec['days']} {spec['at']}-{spec['until']} {TZ_NAME}"
        row["next"] = ("in window now" if spec["state"] == "active" and in_window(spec, local)
                       else next_window_start(spec, local).strftime("%Y-%m-%d %H:%M %Z"))
    except (SpecError, OSError, ValueError, KeyError) as exc:
        row.update(state="invalid", detail=str(exc))
    return row


def cmd_list(args: argparse.Namespace) -> None:
    moment = parse_now(args.now)
    names = spec_names()
    runs = last_runs(names)
    rows = [_summary(n, moment, runs) for n in names]
    if args.json:
        print(json.dumps(rows, sort_keys=True))
        return
    if not rows:
        print("(no bots)")
        return
    for r in rows:
        if r["state"] == "invalid":
            print(f"{r['name']}\tinvalid\t{r['detail']}\tlast-run {r['last_run']}")
            continue
        print(f"{r['name']}\t{r['state']}\t{r['level']}\t{r['role']}\t{r['project']}\t"
              f"{r['schedule']}\texpires {r['expires'] or '-'}\tlast-run {r['last_run']}\tnext {r['next']}")


def cmd_show(args: argparse.Namespace) -> None:
    name = require_name(args.name)
    spec = load_spec(name)
    summary = _summary(name, parse_now(args.now), last_runs([name]))
    spec["last_run"], spec["next"] = summary["last_run"], summary.get("next")
    if args.json:
        print(json.dumps(spec, sort_keys=True))
        return
    for key in FIELDS + ("last_run", "next"):
        value = spec.get(key)
        if isinstance(value, list):
            value = ", ".join(value) if value else None
        print(f"{key}:".ljust(21) + (str(value) if value not in (None, "") else "(none)"))


def cmd_due(args: argparse.Namespace) -> None:
    if args.check:
        # The watcher discards stderr, treats empty stdout as quiet, and
        # kills a check after 30 s, so each line is flushed as it is known,
        # one bot's failure is reported without ending the sweep, and bots
        # left when the budget runs out are named rather than dropped.
        try:
            started = time.monotonic()
            moment = parse_now(args.now)
            names = spec_names()
            for i, name in enumerate(names):
                if time.monotonic() - started > CHECK_BUDGET:
                    print(f"bot error: check reason=deadline unevaluated={','.join(names[i:])}", flush=True)
                    break
                try:
                    line = watcher_line(evaluate(name, moment))
                except Exception as exc:  # noqa: BLE001 - surfaced as a wake, never swallowed
                    line = f"bot error: {name} reason=check-failed-{type(exc).__name__}"
                if line:
                    print(line, flush=True)
        except Exception as exc:  # noqa: BLE001 - surfaced as a wake, never swallowed
            print(f"bot error: check reason=check-failed-{type(exc).__name__}", flush=True)
        return
    moment = parse_now(args.now)
    results = [evaluate(n, moment) for n in spec_names()]
    if args.json:
        print(json.dumps(results, sort_keys=True))
        return
    if not results:
        print("(no bots)")
        return
    for r in results:
        detail = watcher_line(r) or r.get("detail") or ""
        print(f"{r['name']}\t{r['verdict']}\t{r['local']}\t{detail}".rstrip())


# --- dispatch seam --------------------------------------------------------------

FILE_ID_RE = re.compile(r"^([a-z0-9][a-z0-9-]{0,39})-([0-9]{8})\Z")

STOP_RULES = {
    "local-proposal": (
        "Report only: write the report to {report}; never create a branch, edit project files, "
        "commit, or push."
    ),
    "local-commit": (
        "Work only on branch {branch}, within the scope and limits (at most {max_files} files and "
        "{max_lines} changed lines; never touch an excluded path); run the project's tests; leave the "
        "change uncommitted, append needs-decision [key=commit-approval] with the evidence, and stop. "
        "Never commit without the captain's per-commit approval; never push."
    ),
    "push": (
        "Work only on branch {branch}, within the scope and limits (at most {max_files} files and "
        "{max_lines} changed lines; never touch an excluded path); run the project's tests; leave the "
        "change uncommitted, append needs-decision [key=commit-approval] with the evidence, and stop. "
        "Only after the captain's per-commit approval: commit, then push that branch to {push_remote} "
        "at most {push_max_per_run} time this run, with at most one draft PR when the delivery opens "
        "one. Never merge."
    ),
}


def dispatch_plan(spec: dict, result: dict) -> dict:
    """What Firstmate dispatches for one due bot: everything comes from the
    re-validated spec and the effective level, nothing from the wake line."""
    level = result["level"]
    date = result["id"].rsplit("-", 1)[1]
    plan = {
        "id": result["id"], "bot": spec["name"], "spec": spec_rel(spec["name"]),
        "project": spec["project"], "role": spec["role"],
        "role_file": os.path.join(config_root(), "roles", spec["role"], "ROLE.md"),
        "route": spec["route"], "level": level, "requested": result["requested"],
        "scope": spec["scope"], "access": spec["access"], "notify": spec["notify"],
        "wall_clock_min": spec["wall_clock_min"], "max_candidates": spec.get("max_candidates"),
        "max_files": spec.get("max_files"), "max_lines": spec.get("max_lines"),
        "exclude": list(spec.get("exclude") or []),
    }
    if result.get("reason"):
        plan.update(reason=result["reason"], reason_detail=result.get("detail"))
    if level == "local-proposal":
        plan.update(kind="scout", delivery="report", report=f"data/{result['id']}/report.md",
                    approval="none: report only")
    elif level == "local-commit":
        plan.update(kind="ship", delivery="local-only", branch=f"bot/{spec['name']}/{date}",
                    approval="per-commit captain approval before any commit")
    else:
        mode, _yolo = project_posture(spec["project"])
        plan.update(kind="ship", delivery=mode, branch=f"{spec['push_branch_prefix']}{date}",
                    push_remote=spec["push_remote"], push_max_per_run=spec["push_max_per_run"],
                    approval="per-commit captain approval before any commit or push")
    plan["stop_rule"] = STOP_RULES[level].format(**{k: v for k, v in plan.items() if v is not None})
    return plan


def _print_record(record: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps(record, sort_keys=True))
        return
    for key, value in record.items():
        if isinstance(value, list):
            value = ", ".join(value) if value else None
        print(f"{key}:".ljust(17) + (str(value) if value not in (None, "") else "(none)"))


def cmd_file(args: argparse.Namespace) -> None:
    m = FILE_ID_RE.match(args.id or "")
    if not m:
        die(f"refused (bad-id): '{args.id}' is not <bot-name>-<YYYYMMDD>")
    name = m.group(1)
    _refuse_symlink(spec_path(name), "bot spec")
    if not os.path.isfile(spec_path(name)):
        die(f"no such bot '{name}'")
    # Serialized, so two concurrent files of one id cannot both see it due
    # and both print a dispatch plan; the second finds the marker.
    with _lock(".file-lock"):
        _file_locked(args, name)


def _file_locked(args: argparse.Namespace, name: str) -> None:
    result = evaluate(name, parse_now(args.now))
    if result["id"] != args.id:
        die(f"refused (not-today): {args.id} is not {name}'s dated id at {result['local']} "
            f"({result['id']}); bots never backfill")
    verdict = result["verdict"]
    if verdict == "filed":
        print(f"already-filed: {args.id}")
        return
    if verdict not in ("due", "invalid"):
        die(f"refused (not-due): {name} is {verdict} at {result['local']}")
    plan = None
    if verdict == "due":
        plan = dispatch_plan(read_spec(name), result)
        title = f"bot {name} {plan['level']} run, {plan['role']} on {plan['project']}"
        added = _tasks_axi("add", args.id, title, "--kind", plan["kind"], "--repo", plan["project"])
    else:
        added = _tasks_axi("add", args.id, f"bot {name} spec invalid, held for the captain")
    if added is None or added.returncode != 0:
        die(f"refused (backlog-unavailable): fm-tasks-axi.sh add {args.id} failed; nothing filed")
    # The marker is the whole point of filing here: written before any
    # dispatch, it cannot lose a race with that task's completion and pruning.
    try:
        record_filed(name, args.id)
    except OSError as exc:
        die(f"filed {args.id} but could not record its marker ({exc}); do not dispatch until the "
            f"next `fm bot due` records it")
    if plan is not None:
        _print_record(plan, args.json)
        return
    held = _tasks_axi("hold", args.id, "--reason", f"bot spec invalid: {result['reason']}",
                      "--kind", "captain")
    if held is None or held.returncode != 0:
        die(f"filed {args.id} but could not hold it; hold it for the captain by hand")
    _print_record({"held": args.id, "spec": result["spec"], "reason": result["reason"]}, args.json)


def render_check() -> str:
    script = os.path.join(config_root(), "bin", "fm-bot")
    q = shlex.quote
    return (
        "#!/usr/bin/env bash\n"
        "# fm-bot watcher check: one line per due bot, silent otherwise.\n"
        "# Generated by `fm-bot check-install`; bot specs are read at run time, so\n"
        "# creating, pausing, or removing a bot never changes these bytes.\n"
        f"FM_HOME={q(fm_home())}\n"
        f"FIRSTMATE_ROOT={q(firstmate_root())}\n"
        f"py={q(sys.executable)}\n"
        f"bot={q(script)}\n"
        "export FM_HOME FIRSTMATE_ROOT\n"
        '[ -x "$py" ] && [ -f "$bot" ] || { echo "bot error: check reason=fm-bot-missing"; exit 0; }\n'
        'exec "$py" "$bot" due --check "$@"\n'
    )


def cmd_check_install(_args: argparse.Namespace) -> None:
    register = os.path.join(firstmate_root(), "bin", "fm-check-register.sh")
    if not os.path.isfile(register):
        die(f"official check registration is unavailable: {register}")
    state = os.path.join(fm_home(), "state")
    _refuse_symlink(state, "state directory")
    os.makedirs(state, mode=0o700, exist_ok=True)
    _atomic_write(check_path(), render_check(), 0o700)
    out = subprocess.run([register, CHECK_ID], capture_output=True, text=True, timeout=30,
                         env={**os.environ, "FM_HOME": fm_home()})
    if out.returncode != 0:
        die(f"fm-check-register.sh {CHECK_ID} failed: {(out.stderr or out.stdout).strip()}")
    print(f"installed: {check_path()} ({out.stdout.strip()})")


# --- CLI wiring -------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="fm-bot", description=__doc__.splitlines()[0],
                                epilog="\n".join(__doc__.splitlines()[1:]),
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="command", required=True)

    # Field presence and shape are validated by check_base/check_elevated, not
    # argparse, so every refusal carries the same machine-readable code.
    c = sub.add_parser("create")
    c.add_argument("name")
    for flag in ("--role", "--project", "--route", "--at", "--until", "--scope",
                 "--wall-clock-min", "--max-candidates", "--max-files", "--max-lines",
                 "--authorization", "--authorization-scope", "--authorized-on", "--expires",
                 "--push-remote", "--push-branch-prefix", "--push-max-per-run", "--now"):
        c.add_argument(flag)
    c.add_argument("--days", default="daily")
    c.add_argument("--access", default="none")
    c.add_argument("--notify", default="report")
    c.add_argument("--level", default="local-proposal")
    c.add_argument("--exclude", action="append")
    c.set_defaults(func=cmd_create)

    l_ = sub.add_parser("list")
    l_.add_argument("--json", action="store_true")
    l_.add_argument("--now")
    l_.set_defaults(func=cmd_list)

    s = sub.add_parser("show")
    s.add_argument("name")
    s.add_argument("--json", action="store_true")
    s.add_argument("--now")
    s.set_defaults(func=cmd_show)

    for verb, func in (("pause", cmd_pause), ("resume", cmd_resume), ("remove", cmd_remove)):
        v = sub.add_parser(verb)
        v.add_argument("name")
        v.set_defaults(func=func)

    d = sub.add_parser("due")
    d.add_argument("--check", action="store_true")
    d.add_argument("--json", action="store_true")
    d.add_argument("--now")
    d.set_defaults(func=cmd_due)

    f = sub.add_parser("file")
    f.add_argument("id")
    f.add_argument("--json", action="store_true")
    f.add_argument("--now")
    f.set_defaults(func=cmd_file)

    i = sub.add_parser("check-install")
    i.set_defaults(func=cmd_check_install)
    return p


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    args.func(args)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
