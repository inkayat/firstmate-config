#!/usr/bin/env bash
# fm-version - fast, read-only identity summary. Not a health check.
set -u

ENV_FILE="${FM_CONFIG_ENV:-$HOME/.config/firstmate-config/env}"
# shellcheck source=/dev/null
[ ! -f "$ENV_FILE" ] || . "$ENV_FILE"

self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in /*) self=$target ;; *) self="$(cd "$(dirname "$self")" && pwd)/$target" ;; esac
done
CONFIG_ROOT="$(cd "$(dirname "$self")/.." && pwd)"
FIRSTMATE_ROOT="${FIRSTMATE_ROOT:-$HOME/Developer/tools/firstmate}"
FM_HOME="${FM_HOME:-$HOME/.firstmate}"
export GIT_OPTIONAL_LOCKS=0
# Same default/selection owner as launcher and doctor; no availability probes.
# shellcheck source=firstmate/fm-captain-lib.sh
. "$CONFIG_ROOT/firstmate/fm-captain-lib.sh"
harness=
if [ "${1:-}" = --harness ]; then
  [ "$#" -ge 2 ] && [ -n "$2" ] || { printf 'fm-version: --harness requires omp or pi\n' >&2; exit 1; }
  harness=$2
  shift 2
fi
captain_harness_init "$harness" || exit 1

# The one parsing owner for stack compatibility, shared with install.sh and
# bin/fm-doctor. fm-version reads only compact identity metadata from it
# (the validated FirstMate baseline commit) - never a compatibility verdict;
# that stays in `fm doctor`.
# shellcheck source=firstmate/fm-stack-manifest.sh
. "$CONFIG_ROOT/firstmate/fm-stack-manifest.sh"
stack_manifest_load "$CONFIG_ROOT/firstmate/stack-manifest.tsv" || true

JSON=0
case ${1:-} in --json) JSON=1 ;; '') ;; --help|-h) printf 'Usage: fm [--harness omp|pi] version [--json]\n'; exit 0 ;; *) printf 'fm-version: unknown argument '\''%s'\''; see fm version --help\n' "$1" >&2; exit 1 ;; esac
[ -d "$CONFIG_ROOT" ] || { printf 'fm-version: cannot establish firstmate-config path\n' >&2; exit 1; }
[ -n "$FIRSTMATE_ROOT" ] || { printf 'fm-version: cannot establish official FirstMate path\n' >&2; exit 1; }

jesc(){ local s=${1:-}; s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}; s=${s//$'\t'/\\t}; printf '%s' "$s"; }
jstr(){ printf '"%s"' "$(jesc "$1")"; }

git_commit(){ git -C "$1" rev-parse --short HEAD 2>/dev/null || printf unknown; }
git_tag(){ git -C "$1" describe --tags --exact-match 2>/dev/null || git -C "$1" describe --tags --always 2>/dev/null || printf unknown; }
git_state(){ [ -d "$1/.git" ] || git -C "$1" rev-parse --git-dir >/dev/null 2>&1 || { printf unknown; return; }; [ -z "$(git -C "$1" status --porcelain 2>/dev/null)" ] && printf clean || printf dirty; }
version_cmd(){ command -v "$1" >/dev/null 2>&1 || { printf unknown; return; }; "$1" --version 2>/dev/null | awk 'NR==1{print; found=1} END{if(!found) print "unknown"}'; }

cfg_tag=$(git_tag "$CONFIG_ROOT")
cfg_commit=$(git_commit "$CONFIG_ROOT")
cfg_state=$(git_state "$CONFIG_ROOT")
fm_commit=$(git_commit "$FIRSTMATE_ROOT")
fm_state=$(git_state "$FIRSTMATE_ROOT")
pi_version=$(version_cmd "${FM_PI_BIN:-pi}")
omp_version=$(version_cmd "${FM_OMP_BIN:-omp}")
herdr_version=$(version_cmd herdr)
manifest_schema=${SM_SCHEMA_VERSION:-unknown}
manifest_baseline=${SM_FIRSTMATE_COMMIT:-unknown}
platform=$(uname -s 2>/dev/null || printf unknown)
arch=$(uname -m 2>/dev/null || printf unknown)

# The pinned Agent Library and what is installed, through the same read-only
# state rules as install.sh --verify and fm doctor (stack_library status
# never creates or repairs anything), and the root fm would hand the Captain.
LIBRARY_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
lib_state=not_pinned lib_commit='' lib_msg=''
if [ -n "$SM_LIBRARY_REPO" ]; then
  if command -v python3 >/dev/null 2>&1; then
    IFS=$'\t' read -r _ lib_state lib_commit lib_msg < <(stack_library status "$LIBRARY_DATA_HOME" '')
    [ "$lib_commit" != - ] || lib_commit=''
    [ -n "$lib_state" ] || lib_state=unknown
  else
    lib_state=unknown lib_msg='python3 is not on PATH'
  fi
fi
case $lib_state in
  not_pinned) lib_installed='not pinned' ;;
  healthy) lib_installed="$lib_commit (pinned, receipt-owned, tree verified)" ;;
  differs) lib_installed="$lib_commit (differs from the pin $SM_LIBRARY_COMMIT)" ;;
  not_installed) lib_installed=none ;;
  pending) lib_installed='update incomplete (receipt finalize pending)' ;;
  busy) lib_installed='update in progress' ;;
  ownership) lib_installed="invalid ownership: $lib_msg" ;;
  corrupt) lib_installed="corrupt receipt or state: $lib_msg" ;;
  *) lib_installed="unknown${lib_msg:+ ($lib_msg)}" ;;
esac
stack_library_runtime "$LIBRARY_DATA_HOME"
if [ "$SL_RUNTIME_MODE" = explicit ]; then lib_runtime="explicit AGENT_LIBRARY_ROOT=$SL_RUNTIME_ROOT"; else lib_runtime="default root $SL_RUNTIME_ROOT"; fi
if [ -z "$SL_RUNTIME_REASON" ]; then lib_runtime="$lib_runtime (available)"; else lib_runtime="$lib_runtime (unavailable: $SL_RUNTIME_REASON)"; fi
lib_pin_json=null
[ -z "$SM_LIBRARY_REPO" ] || lib_pin_json=$(printf '{"repo":%s,"commit":%s,"tree":%s,"ref":%s}' \
  "$(jstr "$SM_LIBRARY_REPO")" "$(jstr "$SM_LIBRARY_COMMIT")" "$(jstr "$SM_LIBRARY_TREE")" "$(jstr "$SM_LIBRARY_REF")")

if [ "$JSON" -eq 1 ]; then
  printf '{'
  printf '"schema_version":4,'
  printf '"firstmate_config":{"path":%s,"tag":%s,"commit":%s,"state":%s},' "$(jstr "$CONFIG_ROOT")" "$(jstr "$cfg_tag")" "$(jstr "$cfg_commit")" "$(jstr "$cfg_state")"
  printf '"firstmate":{"path":%s,"commit":%s,"state":%s},' "$(jstr "$FIRSTMATE_ROOT")" "$(jstr "$fm_commit")" "$(jstr "$fm_state")"
  printf '"components":{"pi":%s,"omp":%s,"herdr":%s},' "$(jstr "$pi_version")" "$(jstr "$omp_version")" "$(jstr "$herdr_version")"
  printf '"captain_harness":%s,' "$(jstr "$CAPTAIN_HARNESS")"
  printf '"stack_manifest":{"schema_version":%s,"firstmate_validated_commit":%s},' "$(jstr "$manifest_schema")" "$(jstr "$manifest_baseline")"
  printf '"agent_library":{"pin":%s,"installed":{"state":%s,"commit":%s},"runtime":{"mode":%s,"root":%s,"available":%s,"reason":%s}},' \
    "$lib_pin_json" "$(jstr "$lib_state")" "$(jstr "$lib_commit")" "$(jstr "$SL_RUNTIME_MODE")" "$(jstr "$SL_RUNTIME_ROOT")" \
    "$([ -z "$SL_RUNTIME_REASON" ] && printf true || printf false)" "$(jstr "$SL_RUNTIME_REASON")"
  printf '"fm_home":%s,"platform":%s,"architecture":%s' "$(jstr "$FM_HOME")" "$(jstr "$platform")" "$(jstr "$arch")"
  printf '}\n'
else
  printf 'firstmate-config: %s (%s, %s) %s\n' "$cfg_tag" "$cfg_commit" "$cfg_state" "$CONFIG_ROOT"
  printf 'official FirstMate: %s (%s, %s)\n' "$FIRSTMATE_ROOT" "$fm_commit" "$fm_state"
  printf 'Captain harness: %s\n' "$CAPTAIN_HARNESS"
  printf 'Pi: %s\n' "$pi_version"
  printf 'OMP: %s\n' "$omp_version"
  printf 'Herdr: %s\n' "$herdr_version"
  printf 'Validated FirstMate baseline: %s (stack manifest schema %s)\n' "$manifest_baseline" "$manifest_schema"
  if [ -n "$SM_LIBRARY_REPO" ]; then
    printf 'Agent Library pin: %s (tree %s) from %s\n' "$SM_LIBRARY_COMMIT" "$SM_LIBRARY_TREE" "$SM_LIBRARY_REPO"
  else
    printf 'Agent Library pin: none\n'
  fi
  printf 'Agent Library installed: %s\n' "$lib_installed"
  printf 'Agent Library runtime: %s\n' "$lib_runtime"
  printf 'FM_HOME: %s\n' "$FM_HOME"
  printf 'Platform: %s %s\n' "$platform" "$arch"
fi
