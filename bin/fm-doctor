#!/usr/bin/env bash
# fm-doctor - read-only, cross-platform diagnostics for the
# Pi Captain -> FirstMate -> Herdr -> Pi/OMP architecture.
#
# Never installs, repairs, or restarts anything. Never modifies FM_HOME,
# projects, or the official FirstMate checkout. Never makes a paid/live model
# inference call. Every probe here is the same cheap, non-billable kind bin/fm
# already uses at startup (pi auth check, pi --list-models, pi list, claude
# auth status, herdr status --json, omp models --json) - see
# firstmate/fm-captain-lib.sh, the one authoritative Captain availability path
# shared with bin/fm.
#
# Usage:
#   fm doctor             human-readable report
#   fm doctor --json      the same report as machine-readable JSON
#   fm-doctor --help
#
# Exit codes:
#   0   mandatory architecture is healthy, even with WARNING, DEFERRED, or
#       optional BLOCKED_* candidates present
#   1   a genuine mandatory break: missing/broken official FirstMate, invalid
#       captain-startup-models.tsv or crew-dispatch.json, no usable Captain
#       (missing Pi primary extensions, an empty model chain, or every
#       configured model candidate UNAVAILABLE), a missing, explicitly
#       protocol-incompatible, or definitively stopped/unreachable required
#       Herdr server (its own status query failing outright, or reporting
#       running:false), or an expected `fm` shadowed on PATH by a different
#       executable earlier in PATH.
# Every other finding (routing lane availability, roles, skills, harness
# versions, project reporting) is reported but never changes the exit code.
set -u

SCHEMA_VERSION=1

ENV_FILE="${FM_CONFIG_ENV:-$HOME/.config/firstmate-config/env}"
# shellcheck source=/dev/null
[ ! -f "$ENV_FILE" ] || . "$ENV_FILE"

self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self="$(cd "$(dirname "$self")" && pwd)/$target" ;;
  esac
done
CONFIG_ROOT="$(cd "$(dirname "$self")/.." && pwd)"

FIRSTMATE_ROOT="${FIRSTMATE_ROOT:-$HOME/Developer/tools/firstmate}"
FM_HOME="${FM_HOME:-$HOME/.firstmate}"
# Exported so every upstream helper this script shells out to (fm-project-mode.sh,
# fm-lock.sh, fm-supervision-lib.sh) resolves the same home from its own
# environment-variable interface, regardless of whether the caller (a bare
# `fm-doctor` invocation, `fm doctor` before it exports anything, or a test
# fixture) already exported it.
export FM_HOME
# Every git probe below runs with optional locks disabled: this is a
# read-only diagnostic and must never write an index refresh or ref lock
# into firstmate-config, official FirstMate, or a project checkout it merely
# inspects (see git-config(1) core.optionalLocks / GIT_OPTIONAL_LOCKS).
export GIT_OPTIONAL_LOCKS=0
FM_BACKEND="${FM_BACKEND:-herdr}"
PI_BIN="${FM_PI_BIN:-pi}"
SKILLS_ROOT="${FM_SKILLS_ROOT:-$HOME/.agents/skills}"
ORIGIN_CWD=$PWD
MODEL_CHAIN="$CONFIG_ROOT/firstmate/captain-startup-models.tsv"
WATCH_EXT="$FIRSTMATE_ROOT/.pi/extensions/fm-primary-pi-watch.ts"
TURNEND_EXT="$FIRSTMATE_ROOT/.pi/extensions/fm-primary-turnend-guard.ts"
OMP_WATCH_EXT="$FIRSTMATE_ROOT/.omp/extensions/fm-primary-omp-watch.ts"
OMP_TURNEND_EXT="$FIRSTMATE_ROOT/.omp/extensions/fm-primary-turnend-guard.ts"

# The one authoritative Captain availability path, shared with bin/fm. Sets
# PI_BIN above first, exactly as bin/fm does, so the two never fork
# eligibility semantics.
# shellcheck source=firstmate/fm-captain-lib.sh
. "$CONFIG_ROOT/firstmate/fm-captain-lib.sh"

# The one parsing/comparison owner for stack compatibility, shared with
# install.sh. Never fork manifest parsing or version comparison between them.
# shellcheck source=firstmate/fm-stack-manifest.sh
. "$CONFIG_ROOT/firstmate/fm-stack-manifest.sh"
STACK_MANIFEST="$CONFIG_ROOT/firstmate/stack-manifest.tsv"
stack_manifest_load "$STACK_MANIFEST"
STACK_MANIFEST_LOADED=$?

usage() { sed -n '2,/^set -u$/p' "$self" | sed -e 's/^# \{0,1\}//' -e '/^set -u$/d'; }

JSON_MODE=0
case ${1:-} in
  --help|-h) usage; exit 0 ;;
  --json) JSON_MODE=1 ;;
  '') ;;
  *) printf 'fm-doctor: unknown argument '\''%s'\''; see fm-doctor --help\n' "$1" >&2; exit 1 ;;
esac

# --- generic helpers ---------------------------------------------------------

json_esc() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  printf '%s' "$s"
}

jstr() { printf '"%s"' "$(json_esc "${1:-}")"; }

# jtri <true|false|""> -> a JSON true/false/null literal. Used for facts that
# are genuinely unknown (an unavailable upstream helper), never coerced to
# false, so a consumer can tell "no" apart from "couldn't tell".
jtri() {
  case ${1:-} in
    true) printf true ;;
    false) printf false ;;
    *) printf null ;;
  esac
}

json_array() { # <elements...> -> a JSON array of strings
  local out='[' first=1 e
  for e in "$@"; do
    [ "$first" -eq 1 ] || out="$out,"
    out="$out$(jstr "$e")"
    first=0
  done
  printf '%s]' "$out"
}

# Resolve symlinks without executing the target, mirroring bin/fm's own self
# resolution (never invoke an ambiguous discovered `fm`).
canon_path() {
  local p=$1 target dir base
  while [ -L "$p" ]; do
    target=$(readlink "$p")
    case $target in
      /*) p=$target ;;
      *) p="$(cd "$(dirname "$p")" && pwd)/$target" ;;
    esac
  done
  dir=$(cd "$(dirname "$p")" 2>/dev/null && pwd) || { printf '%s' "$p"; return; }
  base=$(basename "$p")
  printf '%s/%s' "$dir" "$base"
}

# Canonical absolute path of an existing directory, or empty when it does not
# exist. Used to match a project by where it actually lives, never by its
# directory's bare name (two unrelated checkouts can share a basename).
real_dir() {
  ( cd "$1" 2>/dev/null && pwd -P )
}

# Portable mtime; Linux stat lacks -f, macOS stat lacks -c (mirrors
# tests/smoke.sh and upstream fm-supervision-lib.sh's fm_sup_stat_mtime).
stat_mtime() {
  stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null
}

git_dirty_count() { # <repo>
  git -C "$1" status --porcelain 2>/dev/null | wc -l | tr -d ' '
}

# --- check accumulator ---------------------------------------------------

CHECK_IDS=()
CHECK_STATUSES=()
CHECK_SUMMARIES=()
CHECK_DETAILS=()

add_check() { # <id> <status> <summary> [<detail>]
  CHECK_IDS+=("$1")
  CHECK_STATUSES+=("$2")
  CHECK_SUMMARIES+=("$3")
  CHECK_DETAILS+=("${4:-}")
}

status_rank() {
  case $1 in
    FAIL) printf 4 ;;
    BLOCKED_AUTH|BLOCKED_QUOTA) printf 3 ;;
    WARNING) printf 2 ;;
    UNKNOWN) printf 1 ;;
    *) printf 0 ;; # PASS, DEFERRED, NOT_APPLICABLE
  esac
}

# =============================================================================
# SYSTEM
# =============================================================================

OS_NAME=$(uname -s 2>/dev/null || printf unknown)
OS_ARCH=$(uname -m 2>/dev/null || printf unknown)
GIT_PROJECT_ROOT=$(git -C "$ORIGIN_CWD" rev-parse --show-toplevel 2>/dev/null || printf '')

add_check system.platform PASS "$OS_NAME/$OS_ARCH" ""
add_check system.fm_home PASS "FM_HOME=$FM_HOME" "$FM_HOME"
if [ -n "$GIT_PROJECT_ROOT" ]; then
  add_check system.git_project PASS "cwd is inside a Git project" "$GIT_PROJECT_ROOT"
else
  add_check system.git_project NOT_APPLICABLE "cwd is not inside a Git project" ""
fi

CONFIG_VERSION=$(git -C "$CONFIG_ROOT" describe --tags --always --dirty 2>/dev/null || printf unknown)
CONFIG_COMMIT=$(git -C "$CONFIG_ROOT" rev-parse --short HEAD 2>/dev/null || printf unknown)
CONFIG_DIRTY=$(git_dirty_count "$CONFIG_ROOT")
add_check firstmate.config PASS "firstmate-config at $CONFIG_VERSION (commit $CONFIG_COMMIT, $CONFIG_DIRTY modification(s))" "$CONFIG_ROOT"
if [ "$STACK_MANIFEST_LOADED" -eq 0 ]; then
  add_check stack.manifest PASS "stack compatibility manifest loaded (schema $SM_SCHEMA_VERSION)" "$STACK_MANIFEST"
else
  add_check stack.manifest FAIL "$SM_LOAD_ERROR" "$STACK_MANIFEST"
fi

FIRSTMATE_BROKEN=0
STACK_COMMIT_INCOMPATIBLE=0
if [ -f "$FIRSTMATE_ROOT/AGENTS.md" ]; then
  FIRSTMATE_COMMIT=$(git -C "$FIRSTMATE_ROOT" rev-parse --short HEAD 2>/dev/null || printf unknown)
  FIRSTMATE_DIRTY=$(git_dirty_count "$FIRSTMATE_ROOT")
  if [ "$FIRSTMATE_DIRTY" = 0 ]; then
    add_check firstmate.official PASS "official FirstMate at $FIRSTMATE_COMMIT, unmodified" "$FIRSTMATE_ROOT"
  else
    add_check firstmate.official WARNING "official FirstMate at $FIRSTMATE_COMMIT has $FIRSTMATE_DIRTY local modification(s); this configuration expects it unmodified" "$FIRSTMATE_ROOT"
  fi
  FIRSTMATE_RELATION=$(stack_commit_relation "$FIRSTMATE_ROOT" "$SM_FIRSTMATE_COMMIT")
  case $FIRSTMATE_RELATION in
    exact) add_check firstmate.commit_compat PASS "matches the validated baseline commit ${SM_FIRSTMATE_COMMIT:0:12}" "$SM_FIRSTMATE_COMMIT" ;;
    descendant) add_check firstmate.commit_compat WARNING "ahead of the validated baseline commit ${SM_FIRSTMATE_COMMIT:0:12}; unvalidated" "$SM_FIRSTMATE_COMMIT" ;;
    ancestor)
      STACK_COMMIT_INCOMPATIBLE=1
      add_check firstmate.commit_compat FAIL "behind the validated baseline commit ${SM_FIRSTMATE_COMMIT:0:12}" "$SM_FIRSTMATE_COMMIT"
      ;;
    diverged)
      STACK_COMMIT_INCOMPATIBLE=1
      add_check firstmate.commit_compat FAIL "history has diverged from the validated baseline commit ${SM_FIRSTMATE_COMMIT:0:12}" "$SM_FIRSTMATE_COMMIT"
      ;;
    *) add_check firstmate.commit_compat UNKNOWN "relationship to the validated baseline commit ${SM_FIRSTMATE_COMMIT:-unknown} cannot be determined from local history" "$SM_FIRSTMATE_COMMIT" ;;
  esac
else
  FIRSTMATE_COMMIT=unknown
  FIRSTMATE_DIRTY=unknown
  FIRSTMATE_BROKEN=1
  add_check firstmate.official FAIL "no AGENTS.md under $FIRSTMATE_ROOT; official FirstMate checkout is missing or broken" "$FIRSTMATE_ROOT"
fi

J_SYSTEM=$(printf '{"os":%s,"arch":%s,"cwd":%s,"git_project_root":%s,"fm_home":%s}' \
  "$(jstr "$OS_NAME")" "$(jstr "$OS_ARCH")" "$(jstr "$ORIGIN_CWD")" "$(jstr "$GIT_PROJECT_ROOT")" "$(jstr "$FM_HOME")")
J_FIRSTMATE=$(printf '{"config":{"path":%s,"version":%s,"commit":%s,"dirty":%s},"official":{"path":%s,"commit":%s,"dirty":%s}}' \
  "$(jstr "$CONFIG_ROOT")" "$(jstr "$CONFIG_VERSION")" "$(jstr "$CONFIG_COMMIT")" "$(jstr "$CONFIG_DIRTY")" \
  "$(jstr "$FIRSTMATE_ROOT")" "$(jstr "$FIRSTMATE_COMMIT")" "$(jstr "$FIRSTMATE_DIRTY")")

# =============================================================================
# LAUNCHER/PATH
# =============================================================================

LAUNCHER_SHADOWED=0
EXPECTED_FM=$(canon_path "$CONFIG_ROOT/bin/fm")
# The executable a plain `fm` invocation would resolve right now. A read-only
# PATH lookup (never executes the target), reported alongside the manual scan
# below so the JSON carries the one fact a user actually hits at the shell.
RESOLVED_FM=$(command -v fm 2>/dev/null || printf '')
FOUND_OURS=0
OTHER_BEFORE=()
OTHER_AFTER=()
ALL_FOUND=()

OLDIFS=$IFS
IFS=:
# shellcheck disable=SC2206 # intentional colon-split of $PATH
PATH_DIRS=($PATH)
IFS=$OLDIFS
for pdir in "${PATH_DIRS[@]}"; do
  [ -n "$pdir" ] || continue
  cand="$pdir/fm"
  [ -f "$cand" ] && [ -x "$cand" ] || continue
  ccanon=$(canon_path "$cand")
  ALL_FOUND+=("$cand -> $ccanon")
  if [ "$ccanon" = "$EXPECTED_FM" ]; then
    FOUND_OURS=1
  elif [ "$FOUND_OURS" -eq 0 ]; then
    OTHER_BEFORE+=("$cand")
  else
    OTHER_AFTER+=("$cand")
  fi
done

LAUNCHER_DETAIL="expected $EXPECTED_FM; PATH order: $(IFS='; '; printf '%s' "${ALL_FOUND[*]:-none found}")"
if [ "${#OTHER_BEFORE[@]}" -gt 0 ]; then
  LAUNCHER_SHADOWED=1
  add_check launcher.resolution FAIL "another 'fm' at $(IFS=', '; printf '%s' "${OTHER_BEFORE[*]}") shadows firstmate-config's fm on PATH" "$LAUNCHER_DETAIL"
elif [ "$FOUND_OURS" -eq 0 ]; then
  add_check launcher.resolution WARNING "firstmate-config's fm ($EXPECTED_FM) is not on PATH" "$LAUNCHER_DETAIL"
elif [ "${#OTHER_AFTER[@]}" -gt 0 ]; then
  add_check launcher.resolution WARNING "firstmate-config's fm resolves first; another 'fm' exists later on PATH at $(IFS=', '; printf '%s' "${OTHER_AFTER[*]}")" "$LAUNCHER_DETAIL"
else
  add_check launcher.resolution PASS "firstmate-config's fm ($EXPECTED_FM) resolves first on PATH" "$LAUNCHER_DETAIL"
fi

J_LAUNCHER=$(printf '{"expected":%s,"resolved":%s,"resolves_first":%s,"found":%s,"competing_before":%s,"competing_after":%s}' \
  "$(jstr "$EXPECTED_FM")" "$(jstr "$RESOLVED_FM")" "$([ "$FOUND_OURS" -eq 1 ] && printf true || printf false)" \
  "$(json_array "${ALL_FOUND[@]}")" "$(json_array "${OTHER_BEFORE[@]}")" "$(json_array "${OTHER_AFTER[@]}")")

# =============================================================================
# CAPTAIN
# =============================================================================

CAPTAIN_EXT_OK=1
if [ -f "$WATCH_EXT" ] && [ -f "$TURNEND_EXT" ]; then
  add_check captain.extensions PASS "both Pi primary extensions present" "$WATCH_EXT; $TURNEND_EXT"
else
  CAPTAIN_EXT_OK=0
  add_check captain.extensions FAIL "missing a required Pi primary extension" "$WATCH_EXT; $TURNEND_EXT"
fi

CAPTAIN_CHAIN_OK=1
SELECTED_MODEL=
SELECTED_EFFORT=
SELECTED_STATE=
FALLBACK_REASON=
CAPTAIN_MODELS_JSON='['
first_model=1
if [ -f "$MODEL_CHAIN" ]; then
  reasons=()
  while IFS="$(printf '\t')" read -r model effort _rest || [ -n "${model:-}" ]; do
    case ${model:-} in ''|\#*) continue ;; esac
    result=$(model_availability "$model" "$effort")
    state=${result%%$'\t'*}
    reason=${result#*$'\t'}
    [ "$first_model" -eq 1 ] || CAPTAIN_MODELS_JSON="$CAPTAIN_MODELS_JSON,"
    CAPTAIN_MODELS_JSON="$CAPTAIN_MODELS_JSON{\"model\":$(jstr "$model"),\"effort\":$(jstr "$effort"),\"state\":$(jstr "$state"),\"reason\":$(jstr "$reason")}"
    first_model=0
    case $state in
      AVAILABLE) add_check "captain.model.$model" PASS "$model ($effort): available" "$reason" ;;
      UNKNOWN) add_check "captain.model.$model" WARNING "$model ($effort): availability unknown" "$reason" ;;
      *) add_check "captain.model.$model" FAIL "$model ($effort): unavailable" "$reason" ;;
    esac
    if [ -z "$SELECTED_MODEL" ] && [ "$state" != UNAVAILABLE ]; then
      SELECTED_MODEL=$model
      SELECTED_EFFORT=$effort
      SELECTED_STATE=$state
    fi
    [ -n "$SELECTED_MODEL" ] || reasons+=("$model $effort: $reason")
  done < "$MODEL_CHAIN"
  [ "${#reasons[@]}" -eq 0 ] || FALLBACK_REASON=$(IFS='; '; printf '%s' "${reasons[*]}")
  if [ -n "$SELECTED_MODEL" ]; then
    if [ -n "$FALLBACK_REASON" ]; then
      add_check captain.selection PASS "selected $SELECTED_MODEL ($SELECTED_EFFORT, $SELECTED_STATE) after fallback" "$FALLBACK_REASON"
    else
      add_check captain.selection PASS "selected preferred candidate $SELECTED_MODEL ($SELECTED_EFFORT)" ""
    fi
  else
    CAPTAIN_CHAIN_OK=0
    add_check captain.selection FAIL "no configured Captain startup model is available" "$FALLBACK_REASON"
  fi
else
  CAPTAIN_CHAIN_OK=0
  add_check captain.model_chain FAIL "missing captain startup model chain" "$MODEL_CHAIN"
fi
CAPTAIN_MODELS_JSON="$CAPTAIN_MODELS_JSON]"

NO_USABLE_CAPTAIN=0
[ "$CAPTAIN_EXT_OK" -eq 1 ] && [ "$CAPTAIN_CHAIN_OK" -eq 1 ] || NO_USABLE_CAPTAIN=1

J_CAPTAIN=$(printf '{"extensions_present":%s,"selected_model":%s,"selected_effort":%s,"selected_availability":%s,"fallback_reason":%s,"candidates":%s}' \
  "$([ "$CAPTAIN_EXT_OK" -eq 1 ] && printf true || printf false)" \
  "$(jstr "$SELECTED_MODEL")" "$(jstr "$SELECTED_EFFORT")" "$(jstr "$SELECTED_STATE")" "$(jstr "$FALLBACK_REASON")" "$CAPTAIN_MODELS_JSON")

# =============================================================================
# RUNTIME (Herdr)
# =============================================================================

HERDR_BROKEN=0
STACK_HERDR_HARD_FAIL=0
HERDR_INCOMPATIBLE=0
HERDR_UNREACHABLE=0
HERDR_CLI_PRESENT=false
HERDR_RUNNING=
HERDR_COMPATIBLE=
HERDR_SERVER_VERSION=
HERDR_CLIENT_VERSION=
if ! command -v herdr >/dev/null 2>&1; then
  HERDR_BROKEN=1
  add_check runtime.herdr_cli FAIL "backend is $FM_BACKEND but the herdr CLI is not on PATH" ""
else
  HERDR_CLI_PRESENT=true
  add_check runtime.herdr_cli PASS "herdr CLI present" "$(command -v herdr)"
  HERDR_STATUS_OUT=$(herdr status --json 2>/dev/null)
  HERDR_STATUS_RC=$?
  HERDR_STATUS_JSON=$HERDR_STATUS_OUT
  [ -n "$HERDR_STATUS_JSON" ] || HERDR_STATUS_JSON='{}'
  HERDR_RUNNING=$(json_bool_field "$HERDR_STATUS_JSON" running)
  HERDR_COMPATIBLE=$(json_bool_field "$HERDR_STATUS_JSON" compatible)
  HERDR_SERVER_VERSION=$(json_string_field "$HERDR_STATUS_JSON" version)
  HERDR_CLIENT_VERSION=$(printf '%s' "$HERDR_STATUS_JSON" | tr '\n' ' ' | sed -n 's/.*"client":{[^}]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
  # The mandatory architecture is Pi Captain -> FirstMate -> Herdr ->
  # Pi/OMP: a definitively stopped or unreachable selected Herdr server is
  # a mandatory FAIL here, not a WARNING. "Definitive" covers herdr's own
  # CLI failing to produce a status at all (nonzero exit or empty stdout -
  # it could not even reach its own server) and an explicit running:false.
  # UNKNOWN is reserved for output that ran and parsed but carries no
  # recognizable "running" field - a case this script genuinely cannot
  # resolve without guessing at an unfamiliar schema.
  if [ "$HERDR_STATUS_RC" -ne 0 ] || [ -z "$HERDR_STATUS_OUT" ]; then
    HERDR_UNREACHABLE=1
    add_check runtime.herdr_server FAIL "herdr status --json failed or produced no output (exit $HERDR_STATUS_RC); the herdr server appears unreachable" "$HERDR_STATUS_OUT"
  elif [ "$HERDR_COMPATIBLE" = false ]; then
    HERDR_INCOMPATIBLE=1
    add_check runtime.herdr_server FAIL "herdr client/server protocol reported incompatible" "$HERDR_STATUS_JSON"
  elif [ "$HERDR_RUNNING" = false ]; then
    HERDR_UNREACHABLE=1
    add_check runtime.herdr_server FAIL "herdr server reported not running (running:false)" "$HERDR_STATUS_JSON"
  elif [ "$HERDR_RUNNING" = true ]; then
    add_check runtime.herdr_server PASS "herdr server running (version ${HERDR_SERVER_VERSION:-unknown}, client ${HERDR_CLIENT_VERSION:-unknown})" ""
  else
    add_check runtime.herdr_server UNKNOWN "herdr status --json produced no recognizable 'running' field; server health cannot be determined without guessing" "$HERDR_STATUS_JSON"
  fi
  HERDR_VER=$(stack_version_extract "$HERDR_SERVER_VERSION")
  case $(stack_component_compat "$HERDR_VER" "$SM_HERDR_MIN" "$SM_HERDR_TESTED") in
    PASS) add_check runtime.herdr_version PASS "herdr server $HERDR_VER satisfies the validated stack policy (tested $SM_HERDR_TESTED)" "" ;;
    WARNING) add_check runtime.herdr_version WARNING "herdr server $HERDR_VER is newer than the tested baseline $SM_HERDR_TESTED; unvalidated" "" ;;
    FAIL)
      STACK_HERDR_HARD_FAIL=1
      add_check runtime.herdr_version FAIL "herdr server $HERDR_VER is below the required minimum $SM_HERDR_MIN" ""
      ;;
    *) add_check runtime.herdr_version UNKNOWN "could not parse a version from herdr's reported server version: ${HERDR_SERVER_VERSION:-<empty>}" "" ;;
  esac
fi

STATE_DIR="$FM_HOME/state"

LOCK_STATUS="lock: free"
LOCK_KNOWN=true
if [ -d "$STATE_DIR" ] && [ -x "$FIRSTMATE_ROOT/bin/fm-lock.sh" ]; then
  lock_out=$("$FIRSTMATE_ROOT/bin/fm-lock.sh" status 2>&1 | tail -1)
  LOCK_STATUS=$lock_out
  add_check runtime.fleet_lock PASS "$lock_out" ""
elif [ ! -d "$STATE_DIR" ] || [ ! -f "$STATE_DIR/.lock" ]; then
  add_check runtime.fleet_lock PASS "lock: free" ""
else
  LOCK_STATUS="lock file present; holder liveness unverified"
  LOCK_KNOWN=false
  add_check runtime.fleet_lock UNKNOWN "lock file present; FirstMate's fm-lock.sh unavailable to verify holder liveness" ""
fi

SUP_LIB="$FIRSTMATE_ROOT/bin/fm-supervision-lib.sh"
WATCHER_NEEDED=
WATCHER_FRESH=
HEARTBEAT_PRESENT=
HEARTBEAT_DESC=unknown
WAKE_PENDING=
IN_FLIGHT=0
TASK_STALENESS=UNKNOWN
if [ -f "$SUP_LIB" ]; then
  # shellcheck source=/dev/null
  . "$SUP_LIB"
  fm_supervision_status "$STATE_DIR" "${FM_GUARD_GRACE:-300}"
  WATCHER_NEEDED=$FM_SUP_NEEDED
  WATCHER_FRESH=$FM_SUP_WATCHER_FRESH
  HEARTBEAT_DESC=$FM_SUP_BEACON_DESC
  WAKE_PENDING=$FM_SUP_QUEUE_PENDING
  IN_FLIGHT=$FM_SUP_IN_FLIGHT
  # Heartbeat is an unconditional fact about the beacon file itself, distinct
  # from the watcher verdict below (which is conditioned on whether
  # supervision is currently needed at all).
  if [ "$FM_SUP_BEACON_DESC" = never ]; then
    HEARTBEAT_PRESENT=false
    add_check runtime.heartbeat NOT_APPLICABLE "no watcher heartbeat has ever been recorded" ""
  else
    HEARTBEAT_PRESENT=true
    if [ "$FM_SUP_WATCHER_FRESH" = true ]; then
      add_check runtime.heartbeat PASS "heartbeat fresh ($FM_SUP_BEACON_DESC)" ""
    else
      add_check runtime.heartbeat WARNING "heartbeat stale ($FM_SUP_BEACON_DESC)" ""
    fi
  fi
  if [ "$FM_SUP_NEEDED" != true ]; then
    add_check runtime.watcher NOT_APPLICABLE "no in-flight work, source, or check; no watcher required" "beacon: $FM_SUP_BEACON_DESC"
  elif [ "$FM_SUP_WATCHER_FRESH" = true ]; then
    add_check runtime.watcher PASS "watcher beacon fresh" "$FM_SUP_BEACON_DESC"
  else
    add_check runtime.watcher WARNING "supervision is needed but no fresh watcher beacon" "$FM_SUP_BEACON_DESC"
  fi
  if [ "$FM_SUP_QUEUE_PENDING" = true ]; then
    add_check runtime.wake_queue WARNING "wake queue has unread records" ""
  else
    add_check runtime.wake_queue PASS "wake queue empty" ""
  fi
  add_check runtime.task_metadata PASS "$FM_SUP_IN_FLIGHT in-flight task record(s)" ""
  # No safe, generic, bulk read-only staleness classifier exists upstream
  # for arbitrary state/*.meta records: fm-crew-state.sh classifies exactly
  # one task at a time and may itself shell out to no-mistakes
  # (fm-classify-lib.sh), which this read-only doctor must never trigger;
  # backend pane-agent-state predicates (e.g. backends/herdr.sh) require an
  # active session/window binding doctor does not have. Rather than
  # duplicate that lifecycle logic or invent a new mtime heuristic here,
  # report NOT_APPLICABLE when there is nothing to classify and UNKNOWN,
  # honestly, otherwise.
  if [ "$FM_SUP_IN_FLIGHT" -eq 0 ]; then
    TASK_STALENESS=NOT_APPLICABLE
    add_check runtime.task_staleness NOT_APPLICABLE "no task records to classify" ""
  else
    TASK_STALENESS=UNKNOWN
    add_check runtime.task_staleness UNKNOWN "$FM_SUP_IN_FLIGHT in-flight task record(s); no safe bulk read-only stale/dead classifier is available without duplicating FirstMate's own per-task lifecycle logic (see bin/fm-crew-state.sh <id> for an authoritative per-task check)" ""
  fi
else
  add_check runtime.heartbeat UNKNOWN "FirstMate's fm-supervision-lib.sh unavailable" ""
  add_check runtime.watcher UNKNOWN "FirstMate's fm-supervision-lib.sh unavailable" ""
  add_check runtime.wake_queue UNKNOWN "FirstMate's fm-supervision-lib.sh unavailable" ""
  add_check runtime.task_metadata UNKNOWN "FirstMate's fm-supervision-lib.sh unavailable" ""
  add_check runtime.task_staleness UNKNOWN "FirstMate's fm-supervision-lib.sh unavailable" ""
fi

J_RUNTIME=$(printf '{"herdr":{"cli_present":%s,"running":%s,"compatible":%s,"server_version":%s,"client_version":%s},"lock":{"status":%s,"known":%s},"watcher":{"needed":%s,"fresh":%s},"heartbeat":{"present":%s,"fresh":%s,"description":%s},"wake_queue":{"pending":%s},"task_metadata":{"in_flight":%s,"staleness":%s}}' \
  "$HERDR_CLI_PRESENT" "$(jtri "$HERDR_RUNNING")" "$(jtri "$HERDR_COMPATIBLE")" "$(jstr "$HERDR_SERVER_VERSION")" "$(jstr "$HERDR_CLIENT_VERSION")" \
  "$(jstr "$LOCK_STATUS")" "$LOCK_KNOWN" \
  "$(jtri "$WATCHER_NEEDED")" "$(jtri "$WATCHER_FRESH")" \
  "$(jtri "$HEARTBEAT_PRESENT")" "$(jtri "$WATCHER_FRESH")" "$(jstr "$HEARTBEAT_DESC")" \
  "$(jtri "$WAKE_PENDING")" \
  "$IN_FLIGHT" "$(jstr "$TASK_STALENESS")")

# =============================================================================
