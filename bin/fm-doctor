STACK_PI_HARD_FAIL=0
STACK_OMP_HARD_FAIL=0
if command -v "$PI_BIN" >/dev/null 2>&1; then
  pi_version=$("$PI_BIN" --version 2>/dev/null | head -1)
  add_check harnesses.pi PASS "Pi installed (${pi_version:-unknown version})" "$(command -v "$PI_BIN")"
  pi_ver=$(stack_version_extract "$pi_version")
  case $(stack_component_compat "$pi_ver" "$SM_PI_MIN" "$SM_PI_TESTED") in
    PASS) add_check harnesses.pi_version PASS "Pi $pi_ver satisfies the validated stack policy (tested $SM_PI_TESTED)" "" ;;
    WARNING) add_check harnesses.pi_version WARNING "Pi $pi_ver is newer than the tested baseline $SM_PI_TESTED; unvalidated" "" ;;
    FAIL)
      STACK_PI_HARD_FAIL=1
      add_check harnesses.pi_version FAIL "Pi $pi_ver is below the required minimum $SM_PI_MIN" ""
      ;;
    *) add_check harnesses.pi_version UNKNOWN "could not parse a version from Pi's --version output: ${pi_version:-<empty>}" "" ;;
  esac
else
  add_check harnesses.pi FAIL "Pi executable '$PI_BIN' is not on PATH" ""
fi

if command -v omp >/dev/null 2>&1; then
  omp_version=$(omp --version 2>/dev/null | head -1)
  add_check harnesses.omp PASS "omp installed (${omp_version:-unknown version})" "$(command -v omp)"
  omp_ver=$(stack_version_extract "$omp_version")
  case $(stack_component_compat "$omp_ver" "$SM_OMP_MIN" "$SM_OMP_TESTED") in
    PASS) add_check harnesses.omp_version PASS "omp $omp_ver satisfies the validated stack policy (tested $SM_OMP_TESTED)" "" ;;
    WARNING) add_check harnesses.omp_version WARNING "omp $omp_ver is newer than the tested baseline $SM_OMP_TESTED; unvalidated" "" ;;
    FAIL)
      STACK_OMP_HARD_FAIL=1
      add_check harnesses.omp_version FAIL "omp $omp_ver is below the required minimum $SM_OMP_MIN" ""
      ;;
    *) add_check harnesses.omp_version UNKNOWN "could not parse a version from omp's --version output: ${omp_version:-<empty>}" "" ;;
  esac
else
  add_check harnesses.omp FAIL "omp executable is not on PATH" ""
fi

if [ -f "$WATCH_EXT" ] && [ -f "$TURNEND_EXT" ]; then
  add_check harnesses.pi_extensions PASS "Pi primary extensions present" ""
else
  add_check harnesses.pi_extensions FAIL "a Pi primary extension is missing" "$WATCH_EXT; $TURNEND_EXT"
fi
if [ -f "$OMP_WATCH_EXT" ] && [ -f "$OMP_TURNEND_EXT" ]; then
  add_check harnesses.omp_extensions PASS "omp primary extensions present" ""
else
  add_check harnesses.omp_extensions FAIL "an omp primary extension is missing" "$OMP_WATCH_EXT; $OMP_TURNEND_EXT"
fi

PI_TRUST="$HOME/.pi/agent/trust.json"
if [ -r "$PI_TRUST" ]; then
  add_check harnesses.pi_config PASS "Pi trust config readable" "$PI_TRUST"
elif [ -e "$PI_TRUST" ]; then
  add_check harnesses.pi_config WARNING "Pi trust config exists but is not readable" "$PI_TRUST"
else
  add_check harnesses.pi_config NOT_APPLICABLE "Pi trust config not yet created" "$PI_TRUST"
fi

OMP_CONFIG="$HOME/.omp/agent/config.yml"
if [ -r "$OMP_CONFIG" ]; then
  add_check harnesses.omp_config PASS "omp config readable" "$OMP_CONFIG"
elif [ -e "$OMP_CONFIG" ]; then
  add_check harnesses.omp_config WARNING "omp config exists but is not readable" "$OMP_CONFIG"
else
  add_check harnesses.omp_config NOT_APPLICABLE "omp config not yet created" "$OMP_CONFIG"
fi

J_HARNESSES=$(printf '{"pi":{"installed":%s,"version":%s},"omp":{"installed":%s,"version":%s}}' \
  "$(command -v "$PI_BIN" >/dev/null 2>&1 && printf true || printf false)" "$(jstr "${pi_version:-}")" \
  "$(command -v omp >/dev/null 2>&1 && printf true || printf false)" "$(jstr "${omp_version:-}")")

# =============================================================================
# ROUTING
# =============================================================================

# omp_model_availability <model> ; prints STATE<TAB>reason. A cheap,
# non-billable catalog lookup (`omp models <provider> --json`), the omp
# equivalent of fm-captain-lib.sh's `pi --list-models` catalog check - never
# the Pi-specific detector, which knows nothing about omp's own providers.
omp_model_availability() {
  local model=$1 provider name out
  provider=$(model_provider "$model")
  name=$(model_name "$model")
  command -v omp >/dev/null 2>&1 || { printf 'UNKNOWN\tomp executable not on PATH'; return; }
  out=$(omp models "$provider" --json 2>/dev/null) || { printf 'UNKNOWN\tomp models catalog unavailable'; return; }
  if printf '%s' "$out" | grep -qF "\"id\":\"$name\""; then
    printf 'AVAILABLE\t'
  else
    printf 'UNAVAILABLE\tmodel not in omp %s catalog' "$provider"
  fi
}

# crew_dispatch_validate <file> - real JSON parsing only, never a new
# required dependency:
#   1. jq, if present (already an accepted optional tool elsewhere in this
#      repository - bin/fm's Pi trust check, tests/smoke.sh's herdr check).
#   2. python3, if present (ships with Xcode CLT on macOS and with virtually
#      every Linux distribution, including Omarchy).
# Neither present -> no real parser exists on this machine. CD_METHOD is set
# to "none" and no parsing is attempted: no brace/bracket balancing, no sed
# field scan pretending to be a parse. The caller reports UNKNOWN, never a
# false PASS, because uncertainty is not the same as validity.
# Sets CD_BAD (empty when valid), CD_METHOD (which tier ran, or "none"), and
# parallel arrays CD_HARNESSES/CD_MODELS/CD_EFFORTS, one entry per lane object
# that carries all three fields together (so, unlike independent field scans,
# a harness/model/effort triple can never drift out of alignment).
crew_dispatch_validate() {
  local file=$1
  CD_BAD=
  CD_HARNESSES=()
  CD_MODELS=()
  CD_EFFORTS=()
  if command -v jq >/dev/null 2>&1; then
    CD_METHOD="jq"
    crew_dispatch_validate_jq "$file"
  elif command -v python3 >/dev/null 2>&1; then
    CD_METHOD="python3"
    crew_dispatch_validate_python3 "$file"
  else
    CD_METHOD="none"
  fi
}

crew_dispatch_validate_jq() {
  local file=$1 err out kind h m e
  if ! err=$(jq -e . "$file" 2>&1 >/dev/null); then
    CD_BAD="malformed JSON ($(printf '%s' "$err" | head -1))"
    return
  fi
  out=$(jq -r '
    if (type!="object") or (has("rules")|not) or (has("default")|not) then
      "BAD"
    else
      "OK"
    end,
    ( [.. | objects | select(has("harness") and has("model") and has("effort"))][] | "LANE\t\(.harness)\t\(.model)\t\(.effort)" )
  ' "$file" 2>/dev/null)
  if [ -z "$out" ]; then
    CD_BAD="jq produced no output"
    return
  fi
  while IFS="$(printf '\t')" read -r kind h m e; do
    case $kind in
      BAD) CD_BAD="missing required 'rules' or 'default' key" ;;
      LANE) CD_HARNESSES+=("$h"); CD_MODELS+=("$m"); CD_EFFORTS+=("$e") ;;
    esac
  done <<EOF
$out
EOF
}

crew_dispatch_validate_python3() {
  local file=$1 out kind h m e
  if ! out=$(python3 - "$file" <<'PY' 2>&1
import json, sys
try:
    with open(sys.argv[1]) as f:
        doc = json.load(f)
except Exception as exc:
    print("BAD\t" + str(exc).replace("\t", " ").replace("\n", " "))
    sys.exit(0)
if not isinstance(doc, dict) or "rules" not in doc or "default" not in doc:
    print("BAD\tmissing required 'rules' or 'default' key")
    sys.exit(0)
print("OK")


def walk(node):
    if isinstance(node, dict):
        if all(k in node for k in ("harness", "model", "effort")):
            print("LANE\t%s\t%s\t%s" % (node["harness"], node["model"], node["effort"]))
        for v in node.values():
            walk(v)
    elif isinstance(node, list):
        for v in node:
            walk(v)


walk(doc)
PY
  ); then
    CD_BAD="python3 JSON parser failed"
    return
  fi
  while IFS="$(printf '\t')" read -r kind h m e; do
    case $kind in
      BAD) CD_BAD=${h:-malformed JSON} ;;
      LANE) CD_HARNESSES+=("$h"); CD_MODELS+=("$m"); CD_EFFORTS+=("$e") ;;
    esac
  done <<EOF
$out
EOF
}

CREW_DISPATCH="$FM_HOME/config/crew-dispatch.json"
[ -f "$CREW_DISPATCH" ] || CREW_DISPATCH="$CONFIG_ROOT/firstmate/crew-dispatch.json"

CREW_DISPATCH_INVALID=0
CREW_DISPATCH_VALID_TRI=""
ROUTING_HARNESSES=()
ROUTING_MODELS=()
ROUTING_EFFORTS=()
CD_METHOD="none"
if [ ! -r "$CREW_DISPATCH" ]; then
  CREW_DISPATCH_INVALID=1
  CREW_DISPATCH_VALID_TRI="false"
  add_check routing.crew_dispatch_valid FAIL "crew-dispatch.json missing or unreadable" "$CREW_DISPATCH"
else
  crew_dispatch_validate "$CREW_DISPATCH"
  if [ "$CD_METHOD" = "none" ]; then
    add_check routing.crew_dispatch_valid UNKNOWN "no JSON parser (jq or python3) available on this machine; crew-dispatch.json validity cannot be determined" "$CREW_DISPATCH"
  else
    bad=$CD_BAD
    if [ -z "$bad" ]; then
      for h in "${CD_HARNESSES[@]}"; do
        case $h in pi|omp) ;; *) bad="invalid harness '$h'"; break ;; esac
      done
    fi
    if [ -z "$bad" ]; then
      for e in "${CD_EFFORTS[@]}"; do
        case $e in off|minimal|low|medium|high|xhigh|max) ;; *) bad="invalid effort '$e'"; break ;; esac
      done
    fi
    if [ -n "$bad" ]; then
      CREW_DISPATCH_INVALID=1
      CREW_DISPATCH_VALID_TRI="false"
      add_check routing.crew_dispatch_valid FAIL "$bad" "$CREW_DISPATCH (parsed via $CD_METHOD)"
    else
      CREW_DISPATCH_VALID_TRI="true"
      ROUTING_HARNESSES=("${CD_HARNESSES[@]}")
      ROUTING_MODELS=("${CD_MODELS[@]}")
      ROUTING_EFFORTS=("${CD_EFFORTS[@]}")
      add_check routing.crew_dispatch_valid PASS "${#ROUTING_MODELS[@]} lane(s), structurally valid" "$CREW_DISPATCH (parsed via $CD_METHOD)"
    fi
  fi
fi

seen=""
for i in "${!ROUTING_MODELS[@]}"; do
  m=${ROUTING_MODELS[$i]}
  e=${ROUTING_EFFORTS[$i]:-medium}
  h=${ROUTING_HARNESSES[$i]:-pi}
  key="$h/$m"
  case ",$seen," in *",$key,"*) continue ;; esac
  seen="$seen,$key"
  case $h in
    omp) result=$(omp_model_availability "$m") ;;
    *) result=$(model_availability "$m" "$e") ;;
  esac
  state=${result%%$'\t'*}
  reason=${result#*$'\t'}
  case $state in
    AVAILABLE) add_check "routing.model.$h.$m" PASS "$h/$m: available" "$reason" ;;
    UNKNOWN) add_check "routing.model.$h.$m" WARNING "$h/$m: availability unknown" "$reason" ;;
    *) add_check "routing.model.$h.$m" FAIL "$h/$m: unavailable" "$reason" ;;
  esac
done

fable_qwen_found=0
for m in "${ROUTING_MODELS[@]}"; do
  case $m in *fable*|*qwen*|*ollama*) fable_qwen_found=1; break ;; esac
done
if [ "$fable_qwen_found" -eq 1 ]; then
  add_check routing.fable_qwen_deferred FAIL "a configured lane's model names Fable and/or Qwen/Ollama; v0.1 policy defers them" "$CREW_DISPATCH"
else
  add_check routing.fable_qwen_deferred DEFERRED "Fable and Qwen/Ollama are intentionally absent from configured crew-dispatch.json lanes; deferred to a later release" ""
fi

J_ROUTING=$(printf '{"crew_dispatch_path":%s,"valid":%s,"lane_count":%s,"parse_method":%s}' \
  "$(jstr "$CREW_DISPATCH")" "$(jtri "$CREW_DISPATCH_VALID_TRI")" "${#ROUTING_MODELS[@]}" "$(jstr "$CD_METHOD")")

# =============================================================================
# ROLES
# =============================================================================

for role in senior-fullstack architecture tenth-man; do
  rf="$CONFIG_ROOT/roles/$role/ROLE.md"
  if [ -r "$rf" ]; then
    add_check "roles.$role" PASS "readable" "$rf"
  else
    add_check "roles.$role" FAIL "missing or unreadable" "$rf"
  fi
done

# =============================================================================
# SKILLS
# =============================================================================

SKILL_EXPECTED=()
for skill_dir in "$CONFIG_ROOT"/skills/*/; do
  [ -f "$skill_dir/SKILL.md" ] || continue
  SKILL_EXPECTED+=("$(basename "$skill_dir")")
done
lock="$CONFIG_ROOT/skills/external.lock"
if [ -f "$lock" ]; then
  while IFS="$(printf '\t')" read -r id _repo _sha _path name; do
    case ${id:-} in ''|\#*) continue ;; esac
    [ -n "${name:-}" ] || continue
    SKILL_EXPECTED+=("$name")
  done < "$lock"
fi

SKILL_MISSING=()
SKILL_BROKEN=()
SKILL_UNREADABLE=()
SKILL_INSTALLED=0
for name in "${SKILL_EXPECTED[@]}"; do
  [ -n "$name" ] || continue
  target="$SKILLS_ROOT/$name"
  if [ ! -e "$target" ] && [ ! -L "$target" ]; then
    SKILL_MISSING+=("$name")
  elif [ -L "$target" ] && [ ! -e "$target" ]; then
    SKILL_BROKEN+=("$name")
  elif [ ! -r "$target/SKILL.md" ]; then
    SKILL_UNREADABLE+=("$name")
  else
    SKILL_INSTALLED=$((SKILL_INSTALLED + 1))
  fi
done

if [ "${#SKILL_MISSING[@]}" -eq 0 ] && [ "${#SKILL_BROKEN[@]}" -eq 0 ] && [ "${#SKILL_UNREADABLE[@]}" -eq 0 ]; then
  add_check skills.global_installation PASS "$SKILL_INSTALLED/${#SKILL_EXPECTED[@]} expected skill(s) installed" "$SKILLS_ROOT"
else
  add_check skills.global_installation FAIL "$SKILL_INSTALLED/${#SKILL_EXPECTED[@]} installed; missing: ${SKILL_MISSING[*]:-none}; broken links: ${SKILL_BROKEN[*]:-none}; unreadable: ${SKILL_UNREADABLE[*]:-none}" "$SKILLS_ROOT"
fi

J_SKILLS=$(printf '{"root":%s,"expected":%s,"installed":%s,"missing":%s,"broken_links":%s,"unreadable":%s}' \
  "$(jstr "$SKILLS_ROOT")" "${#SKILL_EXPECTED[@]}" "$SKILL_INSTALLED" \
  "$(json_array "${SKILL_MISSING[@]}")" "$(json_array "${SKILL_BROKEN[@]}")" "$(json_array "${SKILL_UNREADABLE[@]}")")

# =============================================================================
# PROJECTS
# =============================================================================

PROJECTS_REG="$FM_HOME/data/projects.md"
REG_NAMES=()
if [ -f "$PROJECTS_REG" ]; then
  while IFS= read -r n; do [ -z "$n" ] || REG_NAMES+=("$n"); done < <(awk '$1=="-"{print $2}' "$PROJECTS_REG")
fi

J_PROJECTS_LIST='['
first_proj=1
for name in "${REG_NAMES[@]}"; do
  [ -n "$name" ] || continue
  posture=$("$FIRSTMATE_ROOT/bin/fm-project-mode.sh" "$name" 2>/dev/null || printf 'UNKNOWN UNKNOWN')
  pmode=${posture%% *}
  pyolo=${posture##* }
  ppath="$FM_HOME/projects/$name"
  if [ -d "$ppath" ]; then
    present=true
    origin=$(git -C "$ppath" remote get-url origin 2>/dev/null || printf '')
  else
    present=false
    origin=''
  fi
  [ "$first_proj" -eq 1 ] || J_PROJECTS_LIST="$J_PROJECTS_LIST,"
  J_PROJECTS_LIST="$J_PROJECTS_LIST{\"name\":$(jstr "$name"),\"mode\":$(jstr "$pmode"),\"yolo\":$(jstr "$pyolo"),\"path_present\":$present,\"path\":$(jstr "$ppath"),\"origin\":$(jstr "$origin")}"
  first_proj=0
done
J_PROJECTS_LIST="$J_PROJECTS_LIST]"

if [ "${#REG_NAMES[@]}" -eq 0 ]; then
  add_check projects.registry NOT_APPLICABLE "no registered projects in data/projects.md" "$PROJECTS_REG"
else
  add_check projects.registry PASS "${#REG_NAMES[@]} registered project(s)" "$(IFS=', '; printf '%s' "${REG_NAMES[*]}")"
fi

# Confident current project: cwd must actually BE the registered clone
# ($FM_HOME/projects/<name>), resolved and compared as real canonical paths -
# never a bare basename match, which would misidentify any unrelated
# checkout, worktree, or clone that merely happens to share a directory name
# with a registered project (for example, a disposable task worktree of this
# very repository, whose basename is "firstmate-config").
CURRENT_PROJECT=
GIT_PROJECT_REAL=$(real_dir "${GIT_PROJECT_ROOT:-/nonexistent}")
if [ -n "$GIT_PROJECT_REAL" ]; then
  for name in "${REG_NAMES[@]}"; do
    cand_real=$(real_dir "$FM_HOME/projects/$name")
    if [ -n "$cand_real" ] && [ "$cand_real" = "$GIT_PROJECT_REAL" ]; then
      CURRENT_PROJECT=$name
      break
    fi
  done
fi

J_PROJECTS_CURRENT='null'
if [ -n "$CURRENT_PROJECT" ]; then
  proot="$GIT_PROJECT_ROOT"
  has_override=false; [ -f "$proot/AGENTS.override.md" ] && has_override=true
  has_agents=false; [ -f "$proot/AGENTS.md" ] && has_agents=true
  has_claude=false; [ -f "$proot/CLAUDE.md" ] && has_claude=true
  skill_counts() { # <dir> -> count of entries, 0 if absent
    [ -d "$1" ] || { printf 0; return; }
    find "$1" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l | tr -d ' '
  }
  c_claude=$(skill_counts "$proot/.claude/skills")
  c_agents=$(skill_counts "$proot/.agents/skills")
  c_agent=$(skill_counts "$proot/.agent/skills")
  add_check projects.current PASS "confident current project: $CURRENT_PROJECT" "$proot"
  J_PROJECTS_CURRENT=$(printf '{"name":%s,"path":%s,"agents_override_present":%s,"agents_md_present":%s,"claude_md_present":%s,"project_local_skill_dirs":{"claude":%s,"agents":%s,"agent":%s}}' \
    "$(jstr "$CURRENT_PROJECT")" "$(jstr "$proot")" "$has_override" "$has_agents" "$has_claude" "$c_claude" "$c_agents" "$c_agent")
else
  add_check projects.current NOT_APPLICABLE "no confident current project (cwd is not a registered project's own clone)" ""
fi

J_PROJECTS=$(printf '{"registered":%s,"current":%s}' "$J_PROJECTS_LIST" "$J_PROJECTS_CURRENT")

# =============================================================================
# Overall verdict
# =============================================================================

MANDATORY_FAIL=0
[ "$FIRSTMATE_BROKEN" -eq 0 ] || MANDATORY_FAIL=1
[ "$CREW_DISPATCH_INVALID" -eq 0 ] || MANDATORY_FAIL=1
[ "$NO_USABLE_CAPTAIN" -eq 0 ] || MANDATORY_FAIL=1
[ "$HERDR_BROKEN" -eq 0 ] || MANDATORY_FAIL=1
[ "$HERDR_INCOMPATIBLE" -eq 0 ] || MANDATORY_FAIL=1
[ "$HERDR_UNREACHABLE" -eq 0 ] || MANDATORY_FAIL=1
[ "$LAUNCHER_SHADOWED" -eq 0 ] || MANDATORY_FAIL=1
# A mandatory component below its hard minimum, or the official FirstMate
# checkout at a known-incompatible commit (behind the validated baseline, or
# diverged from it), is a genuine architecture break - not merely advisory.
# Newer-than-tested stays WARNING and an unparseable/unresolvable version or
# commit relation stays UNKNOWN; neither ever reaches this gate.
[ "$STACK_PI_HARD_FAIL" -eq 0 ] || MANDATORY_FAIL=1
[ "$STACK_OMP_HARD_FAIL" -eq 0 ] || MANDATORY_FAIL=1
[ "$STACK_HERDR_HARD_FAIL" -eq 0 ] || MANDATORY_FAIL=1
[ "$STACK_COMMIT_INCOMPATIBLE" -eq 0 ] || MANDATORY_FAIL=1

WORST_RANK=0
for i in "${!CHECK_STATUSES[@]}"; do
  r=$(status_rank "${CHECK_STATUSES[$i]}")
  [ "$r" -le "$WORST_RANK" ] || WORST_RANK=$r
done
case $WORST_RANK in
  4) OVERALL_STATUS=FAIL ;;
  3) OVERALL_STATUS=BLOCKED_AUTH ;;
  2) OVERALL_STATUS=WARNING ;;
  1) OVERALL_STATUS=UNKNOWN ;;
  *) OVERALL_STATUS=PASS ;;
esac

EXIT_CODE=0
[ "$MANDATORY_FAIL" -eq 0 ] || EXIT_CODE=1

# =============================================================================
# Render
# =============================================================================

section_of() {
  case $1 in
    system.*) printf SYSTEM ;;
    firstmate.*) printf SYSTEM ;;
    launcher.*) printf 'LAUNCHER/PATH' ;;
    captain.*) printf CAPTAIN ;;
    runtime.*) printf RUNTIME ;;
    harnesses.*) printf HARNESSES ;;
    routing.*) printf ROUTING ;;
    roles.*) printf ROLES ;;
    skills.*) printf SKILLS ;;
    projects.*) printf PROJECTS ;;
    *) printf OTHER ;;
  esac
}

render_text() {
  local prev_section='' sect
  for i in "${!CHECK_IDS[@]}"; do
    sect=$(section_of "${CHECK_IDS[$i]}")
    if [ "$sect" != "$prev_section" ]; then
      [ -z "$prev_section" ] || printf '\n'
      printf '%s\n' "$sect"
      prev_section=$sect
    fi
    printf '  %-13s %-32s %s\n' "${CHECK_STATUSES[$i]}" "${CHECK_IDS[$i]}" "${CHECK_SUMMARIES[$i]}"
    [ -z "${CHECK_DETAILS[$i]}" ] || printf '      %s\n' "${CHECK_DETAILS[$i]}"
  done
  printf '\nDOCTOR %s exit=%s\n' "$OVERALL_STATUS" "$EXIT_CODE"
}

render_json() {
  local out='{'
  out="$out\"schema_version\":$SCHEMA_VERSION,"
  out="$out\"status\":$(jstr "$OVERALL_STATUS"),"
  out="$out\"exit_code\":$EXIT_CODE,"
  out="$out\"timestamp\":$(jstr "$(date -u +%Y-%m-%dT%H:%M:%SZ)"),"
  out="$out\"system\":$J_SYSTEM,"
  out="$out\"firstmate\":$J_FIRSTMATE,"
  out="$out\"launcher\":$J_LAUNCHER,"
  out="$out\"captain\":$J_CAPTAIN,"
  out="$out\"runtime\":$J_RUNTIME,"
  out="$out\"harnesses\":$J_HARNESSES,"
  out="$out\"routing\":$J_ROUTING,"
  out="$out\"roles\":{"
  local first=1
  for i in "${!CHECK_IDS[@]}"; do
    case ${CHECK_IDS[$i]} in
      roles.*)
        [ "$first" -eq 1 ] || out="$out,"
        out="$out$(jstr "${CHECK_IDS[$i]#roles.}"):$(jstr "${CHECK_STATUSES[$i]}")"
        first=0
        ;;
    esac
  done
  out="$out},"
  out="$out\"skills\":$J_SKILLS,"
  out="$out\"projects\":$J_PROJECTS,"
  out="$out\"checks\":["
  first=1
  for i in "${!CHECK_IDS[@]}"; do
    [ "$first" -eq 1 ] || out="$out,"
    out="$out{\"id\":$(jstr "${CHECK_IDS[$i]}"),\"status\":$(jstr "${CHECK_STATUSES[$i]}"),\"summary\":$(jstr "${CHECK_SUMMARIES[$i]}")"
    [ -z "${CHECK_DETAILS[$i]}" ] || out="$out,\"detail\":$(jstr "${CHECK_DETAILS[$i]}")"
    out="$out}"
    first=0
  done
  out="$out]}"
  printf '%s\n' "$out"
}

if [ "$JSON_MODE" -eq 1 ]; then
  render_json
else
  render_text
fi

exit "$EXIT_CODE"
